# Required for FRED macro and equity-allocation updates.
FRED_API_KEY=

# Required for SEC EDGAR fair-access requests. This is not an API key.
# Use a real monitored address, for example: ArcOfMarket research data@your-domain.com
SEC_IDENTITY=

# Optional licensed S&P 500 analyst-consensus NTM EPS input.
SP500_FORWARD_EPS_NTM=
SP500_FORWARD_EPS_AS_OF=
SP500_FORWARD_EPS_SOURCE=
SP500_FORWARD_EPS_LICENSE_SCOPE=internal
