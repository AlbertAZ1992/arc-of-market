---
import FinancialStressChart from "@/components/charts/FinancialStressChart.astro";
import MacroDashboard from "@/components/charts/MacroDashboard.astro";
import { formatProse } from "@/content/format-prose";
import { pageContent } from "@/content/page-content";
import SiteShell from "@/layouts/SiteShell.astro";

const content = pageContent.macro;
const dockItems = [
  { href: "#macro-policy-rates", label: "SOFR × EFFR × 目标利率" },
  { href: "#macro-term-structure", label: "期限结构" },
  { href: "#macro-yield-spread", label: "10Y − 2Y 期限利差" },
  { href: "#macro-prices", label: "CPI × 核心 PCE × PPI" },
  { href: "#macro-gdp", label: "实际 GDP" },
  { href: "#macro-employment", label: "就业" },
  { href: "#macro-equity-allocation", label: "股票配置占比" },
  { href: "#stress-title", label: "OFR 金融压力" },
  { href: "#macro-positioning", label: "CFTC VIX 仓位" },
  { href: "#macro-credit", label: "信用利差" },
] as const;
---

<SiteShell
  bodyClass="chart-page"
  description={content.seo.description}
  pageNavigation={{ current: content.hero.eyebrow, items: dockItems }}
  title={content.seo.title}
>
  <header class="page-header">
    <div class="page-header__inner">
      <p class="eyebrow">{content.hero.eyebrow}</p>
      <h1>{content.hero.headline}</h1>
      <p class="muted" set:html={formatProse(content.hero.intro)} />
    </div>
  </header>

  <main class="chart-main">
    <MacroDashboard />
    <hr class="rule" />
    <FinancialStressChart />
  </main>

  <footer class="page-footer">
    <a href="/">返回首页</a><span>·</span>
    <a href="/methodology/">方法论</a><span>·</span>
    <a href="/terms/">服务条款</a>
  </footer>

</SiteShell>

<style>
  .chart-main {
    padding: 2.5rem 2.25rem 4.5rem 3rem;
  }

  @media (max-width: 900px) {
    .chart-main {
      padding: 1.5rem 1rem 3.5rem;
    }
  }
</style>
