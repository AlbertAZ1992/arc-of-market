---
import TradingViewResearchSection from "@/components/charts/TradingViewResearchSection.astro";
import SiteShell from "@/layouts/SiteShell.astro";

const dockItems = [
  { href: "#mag7-equal-weight", label: "七巨头等权代理" },
  { href: "#mag7-members", label: "七家公司成员分化" },
  { href: "#mag7-nvda-cisco", label: "NVDA 与 1999 Cisco" },
] as const;
---

<SiteShell
  bodyClass="chart-page"
  description="从七巨头整体代理、成员分化，到集中度、资本开支与相关性。"
  pageNavigation={{ current: "七巨头", items: dockItems }}
  title="七巨头 · ArcOfMarket"
>
  <header class="page-header">
    <div class="page-header__inner">
      <p class="eyebrow">MAGNIFICENT SEVEN</p>
      <h1>七巨头</h1>
      <p class="muted">
        先看整体市场代理，再拆开七家公司，最后观察集中度、资本开支和成员相关性。
      </p>
    </div>
  </header>

  <main class="mag7-main">
    <TradingViewResearchSection
      description="MAGS 是可交易 ETF 代理；与 QQQ、SPY 对照观察头部科技组合和大盘之间的价格差异。"
      id="mag7-equal-weight"
      symbols={[
        ["Roundhill Magnificent Seven ETF", "NASDAQ:MAGS|1D"],
        ["Invesco QQQ", "NASDAQ:QQQ|1D"],
        ["SPDR S&P 500 ETF", "AMEX:SPY|1D"],
      ]}
      title="Magnificent 7 等权代理"
    />
    <TradingViewResearchSection
      description="逐一观察七家公司各自的价格路径，不把这一面板当成自建等权指数。"
      id="mag7-members"
      symbols={[
        ["Apple", "NASDAQ:AAPL|1D"],
        ["Microsoft", "NASDAQ:MSFT|1D"],
        ["Nvidia", "NASDAQ:NVDA|1D"],
        ["Amazon", "NASDAQ:AMZN|1D"],
        ["Alphabet", "NASDAQ:GOOGL|1D"],
        ["Meta", "NASDAQ:META|1D"],
        ["Tesla", "NASDAQ:TSLA|1D"],
      ]}
      title="七家公司成员分化"
    />
    <TradingViewResearchSection
      description="在同一价格组件里查看 Nvidia 与 Cisco 的长期路径；跨时代比较需结合估值、盈利和拆股。"
      id="mag7-nvda-cisco"
      symbols={[
        ["Nvidia", "NASDAQ:NVDA|1D"],
        ["Cisco", "NASDAQ:CSCO|1D"],
      ]}
      title="NVDA 与 1999 Cisco"
    />
  </main>

  <footer class="page-footer">
    <a href="/archive/">全部图表</a><span>·</span>
    <a href="/methodology/">方法论</a><span>·</span>
    <span>仅供信息与教育</span>
  </footer>

</SiteShell>

<style>
  .mag7-main {
    padding: 0 2.25rem 4.5rem 3rem;
  }

  @media (max-width: 900px) {
    .mag7-main {
      padding: 0 1rem 3.5rem;
    }
  }
</style>
