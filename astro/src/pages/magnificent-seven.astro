---
import Mag7Dashboard from "@/components/charts/Mag7Dashboard.astro";
import { formatProse } from "@/content/format-prose";
import { pageContent } from "@/content/page-content";
import SiteShell from "@/layouts/SiteShell.astro";

const content = pageContent.mag7;
const dockItems = [
  { href: "#mag7-equal-weight", label: "七巨头篮子" },
  { href: "#mag7-weight", label: "占标普权重" },
  { href: "#mag7-members", label: "七种命运" },
  { href: "#mag7-drawdowns", label: "每家的熊市" },
  { href: "#mag7-correlation", label: "一篮子交易？" },
  { href: "#mag7-valuation", label: "AI 估值对标" },
  { href: "#mag7-lineage", label: "从哪里来的" },
] as const;
---

<SiteShell
  bodyClass="chart-page"
  description={content.seo.description}
  pageNavigation={{ current: content.hero.eyebrow, items: dockItems }}
  title={content.seo.title}
>
  <header class="page-header">
    <div class="page-header__inner">
      <p class="eyebrow">{content.hero.eyebrow}</p>
      <h1>{content.hero.headline}</h1>
      <p class="muted" set:html={formatProse(content.hero.intro)} />
    </div>
  </header>

  <main class="chart-main">
    <Mag7Dashboard />

    <!-- 教育拓展 -->
    <section class="chapter-section" id="mag7-frameworks">
      <p class="chapter-label">FRAMEWORKS</p>
      <h2>把七巨头放进更大的周期框架</h2>
      <p class="chapter-desc">
        看完数据和谱系之后——这些理论框架可以帮你把七巨头的故事放进更大的坐标系里。
      </p>
      <div class="edu-modules">
        <div class="edu-module edu-module--coming">
          <strong>佩雷斯产业周期</strong>
          <span class="edu-badge">即将推出</span>
          <p>根据 Carlota Perez 的理论，每次技术革命（铁路→钢铁→石油→芯片→AI）都有四个阶段：爆发→狂热→崩溃→成熟。七巨头站在哪一阶段？</p>
        </div>
        <div class="edu-module edu-module--coming">
          <strong>集中度与市场顶点</strong>
          <span class="edu-badge">即将推出</span>
          <p>历史上每次极端集中度（Nifty50、四骑士、FAANG）之后都发生了什么？集中度本身是信号吗？</p>
        </div>
        <div class="edu-module">
          <strong>科技龙头谱系</strong>
          <span class="edu-badge">已有</span>
          <p>从 Nifty50 到 Magnificent 7——每一代科技龙头的时代背景和最终命运。</p>
          <a href="#mag7-lineage">跳转到谱系 →</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="page-footer">
    <a href="/">返回首页</a><span>·</span>
    <a href="/sp500/">标普 500</a><span>·</span>
    <a href="/nasdaq/">纳斯达克</a><span>·</span>
    <a href="/methodology/">方法论</a>
  </footer>

</SiteShell>

<style>
  .chart-main {
    padding: 2.5rem 2.25rem 4.5rem 3rem;
  }

  .chapter-section {
    border-top: 1px solid var(--ink);
    margin-top: 3rem;
    padding-top: 3rem;
    scroll-margin-top: 6rem;
  }

  .chapter-label {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .chapter-section h2 {
    margin: 0.35rem 0 0.4rem;
  }

  .chapter-desc {
    color: var(--ink-soft);
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .edu-modules {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 56rem;
  }

  .edu-module {
    border: 1px solid var(--rule);
    padding: 1rem 1.1rem;
    position: relative;
  }

  .edu-module--coming {
    opacity: 0.6;
  }

  .edu-module strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 0.88rem;
    margin-bottom: 0.3rem;
  }

  .edu-badge {
    background: var(--ink);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.4rem;
    position: absolute;
    right: 0.8rem;
    top: 0.8rem;
    text-transform: uppercase;
  }

  .edu-module--coming .edu-badge {
    background: var(--rule);
    color: var(--ink-faint);
  }

  .edu-module p {
    color: var(--ink-faint);
    font-size: 0.72rem;
    line-height: 1.6;
    margin: 0.3rem 0 0;
  }

  .edu-module a {
    color: var(--main);
    font-size: 0.7rem;
  }

  @media (max-width: 900px) {
    .chart-main {
      padding: 1.5rem 1rem 3.5rem;
    }

    .edu-modules {
      grid-template-columns: 1fr;
    }
  }
</style>
