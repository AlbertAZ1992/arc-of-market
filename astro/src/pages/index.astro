---
import HomeMarketStory from "@/components/HomeMarketStory.astro";
import MarketOverviewChart from "@/components/MarketOverviewChart.astro";
import SolarIcon from "@/components/SolarIcon.astro";
import StrategySignalPreview from "@/components/StrategySignalPreview.astro";
import SiteShell from "@/layouts/SiteShell.astro";
import { loadMarketBrief } from "@/lib/market-brief";

const brief = loadMarketBrief();
const displayDate = brief.asOf.replaceAll("-", ".");
const chapters = [
  { href: "#today-brief", label: "今日结论" },
  { href: "#strategy-signals", label: "策略信号" },
  { href: "#key-evidence", label: "关键证据" },
  { href: "#market-story", label: "五幕市场" },
  { href: "#subscribe", label: "变化提醒" },
] as const;
---

<SiteShell
  bodyClass="market-brief-page"
  description="每天收盘后更新的市场判断、证据与 ArcOfMarket 策略研究。"
  title="ArcOfMarket · 今日市场判断"
>
  <nav aria-label="今日市场章节" class="chapter-rail">
    {
      chapters.map((chapter, index) => (
        <a
          aria-label={chapter.label}
          aria-current={index === 0 ? "location" : undefined}
          data-brief-chapter
          href={chapter.href}
        >
          <span></span>
          <strong>{chapter.label}</strong>
        </a>
      ))
    }
  </nav>

  <main class="market-brief">
    <section class="brief-hero" id="today-brief">
      <p class="eyebrow">MARKET BRIEF · {displayDate} · 盘后</p>
      <p class="brief-kicker">截至最新收盘的数据</p>
      <h1>{brief.headline}</h1>
      <p class="brief-summary">{brief.summary}</p>

      <div class="evidence-strip" aria-label="三项关键证据">
        {
          brief.evidence.map((evidence) => (
            <article data-tone={evidence.tone}>
              <span class="evidence-icon">
                <SolarIcon name={evidence.icon} size={28} />
              </span>
              <div>
                <h2><span>{evidence.label}</span><strong>{evidence.state}</strong></h2>
                <p>{evidence.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <StrategySignalPreview compact />

    <section class="key-evidence" id="key-evidence">
      <div class="evidence-main">
        <header>
          <p>今日关键证据</p>
          <h2>{brief.evidenceTitle}</h2>
          <p>
            四类市场近一年归一化表现 · 一年前 = 100
          </p>
        </header>
        <MarketOverviewChart />
      </div>
      <aside class="evidence-notes">
        <section>
          <h3>风险读数</h3>
          <p>{brief.summary}</p>
        </section>
        <section>
          <h3>市场广度</h3>
          <p>
            过去 20 个交易日有
            {Object.values(brief.marketReturns).filter((value) => value > 0).length}/4
            类市场上涨；S&P 500 高于 50 日均线的成分占
            {brief.breadth.sp50050.toFixed(1)}%，Nasdaq-100 为
            {brief.breadth.ndx50.toFixed(1)}%。
          </p>
        </section>
        <section>
          <h3>什么会改变判断</h3>
          <ul>
            <li>四类市场中三类以上转为 20 日下跌</li>
            <li>标普 500 的 50 日广度跌破 50%</li>
            <li>VIX 与 OFR 金融压力同时高于各自警戒线</li>
          </ul>
        </section>
        <a href="#story-health">
          查看标普与纳指市场广度
          <SolarIcon name="arrow-right-linear" size={19} />
        </a>
      </aside>
    </section>

    <HomeMarketStory />

    <section class="subscribe-panel" id="subscribe">
      <div>
        <p class="eyebrow">NEXT READING</p>
        <h2>查看长期回报、回撤、估值、宏观和指数结构。</h2>
        <p>专题页保留完整历史区间、数据来源、计算口径和判断限制。</p>
      </div>
      <a href="/archive/">进入全部图表</a>
    </section>
  </main>

  <footer class="page-footer brief-footer">
    <span>价格 {brief.sourceDates.price}</span><span>·</span>
    <span>广度 {brief.sourceDates.breadth}</span><span>·</span>
    <span>集中度 {brief.sourceDates.concentration}</span><span>·</span>
    <span>VIX {brief.sourceDates.volatility}</span><span>·</span>
    <span>OFR FSI {brief.sourceDates.stress}</span><span>·</span>
    <a href="/methodology/">方法与数据说明</a>
  </footer>
</SiteShell>

<script>
  const chapterLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-brief-chapter]"),
  );
  const chaptersById = chapterLinks.flatMap((link) => {
    const target = document.querySelector<HTMLElement>(link.hash);
    return target ? [{ link, target }] : [];
  });
  const updateCurrentChapter = (active: HTMLAnchorElement) => {
    chapterLinks.forEach((link) => {
      if (link === active) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };
  const chapterObserver = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top);
      const match = chaptersById.find(({ target }) => target === visible[0]?.target);
      if (match) updateCurrentChapter(match.link);
    },
    { rootMargin: "-18% 0px -72% 0px" },
  );
  chaptersById.forEach(({ target }) => chapterObserver.observe(target));
</script>

<style>
  .market-brief {
    padding: 2rem 2.25rem 0 5.2rem;
  }

  .chapter-rail {
    display: grid;
    gap: 1.15rem;
    left: calc(var(--frame) + var(--side-width) + 1.35rem);
    position: fixed;
    top: 15.5rem;
    z-index: 70;
  }

  .chapter-rail a {
    align-items: center;
    display: flex;
    min-height: 0.35rem;
    position: relative;
  }

  .chapter-rail span {
    border-top: 2px solid var(--rule);
    display: block;
    width: 1.25rem;
  }

  .chapter-rail strong {
    background: var(--ink);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 500;
    left: 2rem;
    opacity: 0;
    padding: 0.3rem 0.45rem;
    pointer-events: none;
    position: absolute;
    transform: translateX(-0.25rem);
    transition: 150ms ease;
    white-space: nowrap;
  }

  .chapter-rail a:hover strong,
  .chapter-rail a:focus-visible strong {
    opacity: 1;
    transform: translateX(0);
  }

  .chapter-rail a[aria-current="location"] span {
    border-color: var(--ink);
    border-width: 4px;
    width: 1.75rem;
  }

  .brief-hero {
    border-bottom: 1px dotted var(--rule);
    padding-bottom: 2.4rem;
    scroll-margin-top: 2rem;
  }

  .brief-kicker {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    margin: 1.4rem 0 0.75rem;
  }

  .brief-hero h1 {
    font-size: clamp(2.65rem, 4.15vw, 4.45rem);
    line-height: 1.2;
    margin-bottom: 0.8rem;
    max-width: 71rem;
  }

  .brief-summary {
    color: var(--ink-soft);
    font-size: 1rem;
    margin-bottom: 2rem;
    max-width: 61rem;
  }

  .evidence-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .evidence-strip article {
    align-items: center;
    display: grid;
    gap: 1rem;
    grid-template-columns: auto 1fr;
    min-height: 5.3rem;
    padding: 0 2rem;
  }

  .evidence-strip article:first-child {
    padding-left: 0;
  }

  .evidence-strip article + article {
    border-left: 1px solid var(--rule);
  }

  .evidence-icon {
    align-items: center;
    border: 1.5px solid var(--main);
    border-radius: 50%;
    color: var(--main);
    display: flex;
    height: 3.25rem;
    justify-content: center;
    width: 3.25rem;
  }

  .evidence-strip h2 {
    align-items: baseline;
    display: flex;
    font-size: 1.05rem;
    gap: 0.7rem;
    margin-bottom: 0.15rem;
  }

  .evidence-strip h2 span {
    border-right: 1px solid var(--rule);
    padding-right: 0.7rem;
  }

  .evidence-strip h2 strong {
    font-weight: 900;
  }

  .evidence-strip p {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin: 0;
  }

  .key-evidence {
    border-bottom: 1px dotted var(--rule);
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(17rem, 0.9fr);
    scroll-margin-top: 2rem;
  }

  .evidence-main {
    padding: 2rem 2rem 2rem 0;
  }

  .evidence-main > header > p:first-child {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .evidence-main h2 {
    font-size: clamp(1.45rem, 2.25vw, 2.25rem);
    margin-bottom: 0.55rem;
  }

  .evidence-main > header > p:last-child {
    align-items: center;
    display: flex;
    font-size: 0.72rem;
    gap: 0.55rem;
  }

  .evidence-notes {
    border-left: 1px solid var(--rule);
    padding: 2rem 0 2rem 1.8rem;
  }

  .evidence-notes section {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1rem;
  }

  .evidence-notes section + section {
    padding-top: 1rem;
  }

  .evidence-notes h3 {
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  .evidence-notes p,
  .evidence-notes li {
    font-size: 0.75rem;
  }

  .evidence-notes ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .evidence-notes > a {
    align-items: center;
    display: flex;
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-weight: 700;
    gap: 0.3rem;
    padding-top: 1rem;
  }

  .subscribe-panel {
    align-items: center;
    background: var(--ink);
    color: #fff;
    display: flex;
    justify-content: space-between;
    margin-inline: -2.25rem;
    padding: 2rem 2.25rem 2rem 5.2rem;
    scroll-margin-top: 2rem;
  }

  .subscribe-panel h2 {
    margin: 0.3rem 0;
  }

  .subscribe-panel p:last-child {
    color: #bdbdbd;
    font-size: 0.78rem;
    margin: 0;
  }

  .subscribe-panel > a {
    background: var(--main);
    color: #fff;
    font-family: var(--font-serif);
    font-weight: 700;
    padding: 0.8rem 1.2rem;
  }

  .brief-footer {
    margin-top: 0;
    padding-left: 5.2rem;
  }

  @media (max-width: 900px) {
    .market-brief {
      padding: 1.3rem 1rem 0;
    }

    .chapter-rail {
      display: none;
    }

    .brief-hero h1 {
      font-size: 2.45rem;
    }

    .subscribe-panel {
      margin-inline: -1rem;
      padding: 2rem 1rem;
    }

    .brief-footer {
      padding-left: 1rem;
    }
  }

  @media (max-width: 700px) {
    .evidence-strip,
    .key-evidence {
      display: block;
    }

    .evidence-strip article {
      padding: 1rem 0;
    }

    .evidence-strip article + article {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

    .evidence-main {
      padding-right: 0;
    }

    .evidence-notes {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-left: 0;
    }

    .subscribe-panel {
      align-items: flex-start;
      display: grid;
      gap: 1rem;
    }
  }
</style>
