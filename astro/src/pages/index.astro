---
import HomeMarketStory from "@/components/HomeMarketStory.astro";
import MarketBriefChart from "@/components/MarketBriefChart.astro";
import SolarIcon from "@/components/SolarIcon.astro";
import SiteShell from "@/layouts/SiteShell.astro";
import { loadMarketBrief } from "@/lib/market-brief";
import { signalPublication } from "@/lib/signal-publication";

const brief = loadMarketBrief();
const displayDate = brief.asOf.replaceAll("-", ".");
const strategies = ["QQQ 量化", "动量交易", "QQQ · VTV 反转", "佩雷斯产业周期"];
const chapters = [
  { href: "#today-brief", label: "今日结论" },
  { href: "#strategy-signals", label: "策略信号" },
  { href: "#key-evidence", label: "关键证据" },
  { href: "#market-story", label: "五幕市场" },
  { href: "#subscribe", label: "变化提醒" },
] as const;
---

<SiteShell
  bodyClass="market-brief-page"
  description="每天收盘后更新的市场判断、证据与 ArcOfMarket 策略研究。"
  title="ArcOfMarket · 今日市场判断"
>
  <nav aria-label="今日市场章节" class="chapter-rail">
    {
      chapters.map((chapter, index) => (
        <a
          aria-label={chapter.label}
          aria-current={index === 0 ? "location" : undefined}
          data-brief-chapter
          href={chapter.href}
        >
          <span></span>
          <strong>{chapter.label}</strong>
        </a>
      ))
    }
  </nav>

  <main class="market-brief">
    <section class="brief-hero" id="today-brief">
      <p class="eyebrow">MARKET BRIEF · {displayDate} · 盘后</p>
      <p class="brief-kicker">一句话今日判断</p>
      <h1>{brief.headline}</h1>
      <p class="brief-summary">{brief.summary}</p>

      <div class="evidence-strip" aria-label="三项关键证据">
        {
          brief.evidence.map((evidence) => (
            <article data-tone={evidence.tone}>
              <span class="evidence-icon">
                <SolarIcon name={evidence.icon} size={28} />
              </span>
              <div>
                <h2><span>{evidence.label}</span><strong>{evidence.state}</strong></h2>
                <p>{evidence.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="signal-preview" id="strategy-signals">
      <div class="signal-intro">
        <p class="eyebrow">STRATEGY SIGNALS</p>
        <h2>{signalPublication.previewTitle}</h2>
        <strong>{signalPublication.previewStatus}</strong>
        <p>{signalPublication.previewDetail}</p>
      </div>
      <div class="signal-lock">
        <div class="strategy-names">
          <strong>四项策略</strong>
          <span>{strategies.join(" ／ ")}</span>
        </div>
        <div class="locked-fields" aria-label="尚未启用的执行字段">
          {
            ["方向", "仓位", "下一触发"].map((label) => (
              <span>
                <SolarIcon name="lock-keyhole-minimalistic-linear" size={19} />
                {label}<b>•••</b>
              </span>
            ))
          }
        </div>
      </div>
      <div class="signal-actions">
        <a class="primary-action" href="/signals/">查看策略框架</a>
        <a class="secondary-action" href="/signals/#validation">
          查看上线门禁
          <SolarIcon name="arrow-right-linear" size={19} />
        </a>
      </div>
    </section>

    <section class="key-evidence" id="key-evidence">
      <div class="evidence-main">
        <header>
          <p>今日关键证据</p>
          <h2>标普 500：趋势仍在，波动率尚未确认系统性风险</h2>
          <p>
            <span class="legend-line legend-line--price"></span>S&P 500 收盘价（左轴）
            <span class="legend-line legend-line--risk"></span>VIX（右轴）
          </p>
        </header>
        <MarketBriefChart />
      </div>
      <aside class="evidence-notes">
        <section>
          <h3>结论</h3>
          <p>{brief.summary}</p>
        </section>
        <section>
          <h3>为什么重要</h3>
          <p>
            价格趋势需要波动率和金融压力共同确认。VIX 当前为
            {brief.vix.toFixed(1)}，尚不足以单独证明系统性风险已经扩散。
          </p>
        </section>
        <section>
          <h3>什么会改变判断</h3>
          <ul>
            <li>价格跌破长期趋势并持续</li>
            <li>OFR FSI 回到历史均值上方</li>
            <li>VIX 与信用压力同步放大</li>
          </ul>
        </section>
        <a href="#story-health">
          下一幕：上涨是否由整个市场推动
          <SolarIcon name="arrow-right-linear" size={19} />
        </a>
      </aside>
    </section>

    <HomeMarketStory />

    <section class="subscribe-panel" id="subscribe">
      <div>
        <p class="eyebrow">CHANGE ALERTS</p>
        <h2>当判断发生变化时提醒我。</h2>
        <p>策略公式尚未确认，订阅暂不开放；完成验证后再提供状态与变化提醒。</p>
      </div>
      <a href="/signals/">查看 Strategy Signals 研究框架</a>
    </section>
  </main>

  <footer class="page-footer brief-footer">
    <span>数据日期 {brief.asOf}</span><span>·</span>
    <span>来源：Yahoo Finance · Cboe · OFR</span><span>·</span>
    <a href="/methodology/">方法与数据说明</a>
  </footer>
</SiteShell>

<script>
  const chapterLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-brief-chapter]"),
  );
  const chaptersById = chapterLinks.flatMap((link) => {
    const target = document.querySelector<HTMLElement>(link.hash);
    return target ? [{ link, target }] : [];
  });
  const updateCurrentChapter = (active: HTMLAnchorElement) => {
    chapterLinks.forEach((link) => {
      if (link === active) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };
  const chapterObserver = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top);
      const match = chaptersById.find(({ target }) => target === visible[0]?.target);
      if (match) updateCurrentChapter(match.link);
    },
    { rootMargin: "-18% 0px -72% 0px" },
  );
  chaptersById.forEach(({ target }) => chapterObserver.observe(target));
</script>

<style>
  .market-brief {
    padding: 2rem 2.25rem 0 5.2rem;
  }

  .chapter-rail {
    display: grid;
    gap: 1.15rem;
    left: calc(var(--frame) + var(--side-width) + 1.35rem);
    position: fixed;
    top: 15.5rem;
    z-index: 70;
  }

  .chapter-rail a {
    align-items: center;
    display: flex;
    min-height: 0.35rem;
    position: relative;
  }

  .chapter-rail span {
    border-top: 2px solid var(--rule);
    display: block;
    width: 1.25rem;
  }

  .chapter-rail strong {
    background: var(--ink);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 500;
    left: 2rem;
    opacity: 0;
    padding: 0.3rem 0.45rem;
    pointer-events: none;
    position: absolute;
    transform: translateX(-0.25rem);
    transition: 150ms ease;
    white-space: nowrap;
  }

  .chapter-rail a:hover strong,
  .chapter-rail a:focus-visible strong {
    opacity: 1;
    transform: translateX(0);
  }

  .chapter-rail a[aria-current="location"] span {
    border-color: var(--ink);
    border-width: 4px;
    width: 1.75rem;
  }

  .brief-hero {
    border-bottom: 1px dotted var(--rule);
    padding-bottom: 2.4rem;
    scroll-margin-top: 2rem;
  }

  .brief-kicker {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    margin: 1.4rem 0 0.75rem;
  }

  .brief-hero h1 {
    font-size: clamp(2.65rem, 4.15vw, 4.45rem);
    line-height: 1.2;
    margin-bottom: 0.8rem;
    max-width: 71rem;
  }

  .brief-summary {
    color: var(--ink-soft);
    font-size: 1rem;
    margin-bottom: 2rem;
    max-width: 61rem;
  }

  .evidence-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .evidence-strip article {
    align-items: center;
    display: grid;
    gap: 1rem;
    grid-template-columns: auto 1fr;
    min-height: 5.3rem;
    padding: 0 2rem;
  }

  .evidence-strip article:first-child {
    padding-left: 0;
  }

  .evidence-strip article + article {
    border-left: 1px solid var(--rule);
  }

  .evidence-icon {
    align-items: center;
    border: 1.5px solid var(--main);
    border-radius: 50%;
    color: var(--main);
    display: flex;
    height: 3.25rem;
    justify-content: center;
    width: 3.25rem;
  }

  .evidence-strip h2 {
    align-items: baseline;
    display: flex;
    font-size: 1.05rem;
    gap: 0.7rem;
    margin-bottom: 0.15rem;
  }

  .evidence-strip h2 span {
    border-right: 1px solid var(--rule);
    padding-right: 0.7rem;
  }

  .evidence-strip h2 strong {
    font-weight: 900;
  }

  .evidence-strip p {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin: 0;
  }

  .signal-preview {
    border-bottom: 1px dotted var(--rule);
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) minmax(32rem, 1.7fr) minmax(12rem, 0.55fr);
    min-height: 10.5rem;
    scroll-margin-top: 2rem;
  }

  .signal-preview > * {
    padding: 1.5rem 1.5rem;
  }

  .signal-preview > *:first-child {
    padding-left: 0;
  }

  .signal-preview > * + * {
    border-left: 1px solid var(--rule);
  }

  .signal-intro h2 {
    font-size: 1.15rem;
    margin: 0.25rem 0 0.2rem;
  }

  .signal-intro > strong {
    color: var(--main);
    display: block;
    font-family: var(--font-serif);
    font-size: 0.88rem;
  }

  .signal-intro > p:last-child {
    font-size: 0.72rem;
    margin: 0.45rem 0 0;
  }

  .signal-lock {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .strategy-names {
    align-items: center;
    border-bottom: 1px solid var(--rule);
    display: flex;
    font-size: 0.77rem;
    gap: 2rem;
    padding-bottom: 0.8rem;
  }

  .locked-fields {
    align-items: center;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .locked-fields > span {
    align-items: center;
    display: flex;
    font-size: 0.8rem;
    gap: 0.65rem;
  }

  .locked-fields b {
    font-family: var(--font-mono);
    letter-spacing: 0.2em;
  }

  .signal-actions {
    align-items: center;
    display: grid;
    gap: 0.75rem;
  }

  .primary-action {
    background: var(--main);
    color: #fff;
    font-family: var(--font-serif);
    font-weight: 700;
    padding: 0.75rem 1rem;
    text-align: center;
  }

  .primary-action:hover {
    color: #fff;
  }

  .secondary-action {
    align-items: center;
    display: flex;
    font-size: 0.75rem;
    gap: 0.35rem;
    justify-content: center;
  }

  .key-evidence {
    border-bottom: 1px dotted var(--rule);
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(17rem, 0.9fr);
    scroll-margin-top: 2rem;
  }

  .evidence-main {
    padding: 2rem 2rem 2rem 0;
  }

  .evidence-main > header > p:first-child {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .evidence-main h2 {
    font-size: clamp(1.45rem, 2.25vw, 2.25rem);
    margin-bottom: 0.55rem;
  }

  .evidence-main > header > p:last-child {
    align-items: center;
    display: flex;
    font-size: 0.72rem;
    gap: 0.55rem;
  }

  .legend-line {
    border-top: 2px solid var(--ink);
    display: inline-block;
    width: 1.75rem;
  }

  .legend-line--risk {
    border-color: var(--main);
    margin-left: 1rem;
  }

  .evidence-notes {
    border-left: 1px solid var(--rule);
    padding: 2rem 0 2rem 1.8rem;
  }

  .evidence-notes section {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1rem;
  }

  .evidence-notes section + section {
    padding-top: 1rem;
  }

  .evidence-notes h3 {
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  .evidence-notes p,
  .evidence-notes li {
    font-size: 0.75rem;
  }

  .evidence-notes ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .evidence-notes > a {
    align-items: center;
    display: flex;
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-weight: 700;
    gap: 0.3rem;
    padding-top: 1rem;
  }

  .subscribe-panel {
    align-items: center;
    background: var(--ink);
    color: #fff;
    display: flex;
    justify-content: space-between;
    margin-inline: -2.25rem;
    padding: 2rem 2.25rem 2rem 5.2rem;
    scroll-margin-top: 2rem;
  }

  .subscribe-panel h2 {
    margin: 0.3rem 0;
  }

  .subscribe-panel p:last-child {
    color: #bdbdbd;
    font-size: 0.78rem;
    margin: 0;
  }

  .subscribe-panel > a {
    background: var(--main);
    color: #fff;
    font-family: var(--font-serif);
    font-weight: 700;
    padding: 0.8rem 1.2rem;
  }

  .brief-footer {
    margin-top: 0;
    padding-left: 5.2rem;
  }

  @media (max-width: 1100px) {
    .signal-preview {
      grid-template-columns: 1fr 1.7fr;
    }

    .signal-actions {
      border-left: 0;
      border-top: 1px solid var(--rule);
      grid-column: 1 / -1;
      grid-template-columns: 1fr 1fr;
    }

  }

  @media (max-width: 900px) {
    .market-brief {
      padding: 1.3rem 1rem 0;
    }

    .chapter-rail {
      display: none;
    }

    .brief-hero h1 {
      font-size: 2.45rem;
    }

    .subscribe-panel {
      margin-inline: -1rem;
      padding: 2rem 1rem;
    }

    .brief-footer {
      padding-left: 1rem;
    }
  }

  @media (max-width: 700px) {
    .evidence-strip,
    .key-evidence,
    .signal-preview {
      display: block;
    }

    .evidence-strip article {
      padding: 1rem 0;
    }

    .evidence-strip article + article,
    .signal-preview > * + * {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

    .signal-preview > * {
      padding-inline: 0;
    }

    .signal-actions {
      grid-template-columns: 1fr;
    }

    .evidence-main {
      padding-right: 0;
    }

    .evidence-notes {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-left: 0;
    }

    .subscribe-panel {
      align-items: flex-start;
      display: grid;
      gap: 1rem;
    }
  }
</style>
