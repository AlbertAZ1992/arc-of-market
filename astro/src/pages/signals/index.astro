---
import SolarIcon from "@/components/SolarIcon.astro";
import SiteShell from "@/layouts/SiteShell.astro";

const strategies = [
  {
    answer: "纳指风险敞口当前应持有、降低还是退出。",
    cadence: "日频",
    code: "01",
    role: "核心行动信号",
    title: "QQQ 量化策略",
  },
  {
    answer: "趋势强度、交易时机与风险预算是否允许增加。",
    cadence: "日频 / 周频",
    code: "02",
    role: "交易节奏",
    title: "动量交易信号",
  },
  {
    answer: "成长与价值之间是否正在形成可验证的反转。",
    cadence: "周频",
    code: "03",
    role: "风格切换",
    title: "QQQ / VTV 反转",
  },
  {
    answer: "当前处于技术革命与资本部署的哪个长期阶段。",
    cadence: "月频",
    code: "04",
    role: "长期环境",
    title: "佩雷斯产业周期",
  },
] as const;
---

<SiteShell
  bodyClass="signals-page"
  description="ArcOfMarket 四项原创策略的用途、验证门槛、公开方法与订阅边界。"
  title="Strategy Signals · ArcOfMarket"
>
  <main class="signals">
    <header class="signals-hero">
      <p class="eyebrow">STRATEGY SIGNALS</p>
      <h1>从长期环境，走到今天可以执行的动作。</h1>
      <p>
        四项策略回答不同时间尺度的问题。方法、历史验证、失败样本和版本保持公开；
        只有通过验证门槛后，最新方向、仓位与触发条件才会进入订阅。
      </p>
    </header>

    <section class="strategy-list" aria-label="四项策略">
      {
        strategies.map((strategy) => (
          <article>
            <span class="strategy-code">{strategy.code}</span>
            <div class="strategy-name">
              <p>{strategy.role}</p>
              <h2>{strategy.title}</h2>
            </div>
            <p class="strategy-answer">{strategy.answer}</p>
            <p class="strategy-cadence">{strategy.cadence}</p>
            <span class="strategy-state">验证中</span>
          </article>
        ))
      }
    </section>

    <section class="locked-signal" aria-labelledby="locked-title">
      <div>
        <p class="eyebrow">CURRENT EXECUTION</p>
        <h2 id="locked-title">当前执行状态</h2>
        <p>策略完成样本外验证并发布版本记录后，这里会显示最新执行变化。</p>
      </div>
      <div class="locked-values" aria-label="当前订阅字段">
        {
          ["最新方向", "目标仓位", "上一状态变化", "下一触发", "失效条件"].map(
            (field) => (
              <span>
                <SolarIcon
                  name="lock-keyhole-minimalistic-linear"
                  size={19}
                />
                {field}<b>•••</b>
              </span>
            ),
          )
        }
      </div>
      <p class="validation-gate">尚未开放订阅 · 先完成验证，再决定价格与提醒渠道</p>
    </section>

    <section class="validation" id="validation">
      <header>
        <p class="eyebrow">PUBLIC VALIDATION</p>
        <h2>免费内容先证明策略是否值得信任。</h2>
      </header>
      <div class="validation-grid">
        <article>
          <span>01</span>
          <h3>方法与状态体系</h3>
          <p>说明策略解决的问题、输入数据、状态定义、触发逻辑与无法覆盖的情形。</p>
        </article>
        <article>
          <span>02</span>
          <h3>历史表现与基准</h3>
          <p>展示净值、基准、年化收益、最大回撤与风险调整后收益，不只挑选漂亮区间。</p>
        </article>
        <article>
          <span>03</span>
          <h3>失败样本与修订</h3>
          <p>保留错误信号、失效环境、版本差异和修改日期，让未来表现可以复核。</p>
        </article>
        <article>
          <span>04</span>
          <h3>时间戳与延迟记录</h3>
          <p>记录每次信号的生成时间与数据日期；公开延迟信号，避免事后重写历史。</p>
        </article>
      </div>
    </section>

    <section class="boundary">
      <p class="eyebrow">THE PRODUCT BOUNDARY</p>
      <h2>免费卖信任，订阅卖及时性、精确性与执行性。</h2>
      <div>
        <article>
          <h3>始终公开</h3>
          <p>策略用途、方法、历史验证、失败样本、版本记录与延迟信号。</p>
        </article>
        <article>
          <h3>验证后订阅</h3>
          <p>最新方向、目标仓位、状态变化、下一触发、失效条件与变化提醒。</p>
        </article>
      </div>
      <a href="/methodology/">
        查看方法论与数据说明
        <SolarIcon name="arrow-right-linear" size={19} />
      </a>
    </section>
  </main>

  <footer class="page-footer signals-footer">
    <span>© 2026 ArcOfMarket</span><span>·</span>
    <span>策略研究不构成个性化投资建议</span><span>·</span>
    <a href="/">返回今日市场判断</a>
  </footer>
</SiteShell>

<style>
  .signals {
    padding: 2rem 2.25rem 0 3rem;
  }

  .signals-hero {
    border-bottom: 1px dotted var(--rule);
    padding-bottom: 3rem;
  }

  .signals-hero h1 {
    font-size: clamp(2.5rem, 4vw, 4.2rem);
    margin: 1.2rem 0 1rem;
    max-width: 76rem;
  }

  .signals-hero > p:last-child {
    color: var(--ink-soft);
    max-width: 48rem;
  }

  .strategy-list article {
    align-items: center;
    border-bottom: 1px dotted var(--rule);
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 3rem minmax(12rem, 0.9fr) minmax(18rem, 1.35fr) 7rem 5rem;
    min-height: 9rem;
  }

  .strategy-code,
  .strategy-cadence {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .strategy-name p {
    color: var(--main);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .strategy-name h2 {
    font-size: 1.2rem;
    margin: 0.15rem 0 0;
  }

  .strategy-answer {
    font-size: 0.84rem;
    margin: 0;
  }

  .strategy-state {
    border: 1px solid var(--main);
    color: var(--main);
    font-size: 0.7rem;
    padding: 0.25rem 0.45rem;
    text-align: center;
  }

  .locked-signal {
    border-bottom: 1px dotted var(--rule);
    display: grid;
    grid-template-columns: minmax(14rem, 0.75fr) minmax(32rem, 1.8fr);
    padding: 3.5rem 0;
  }

  .locked-signal > div:first-child {
    border-right: 1px solid var(--rule);
    padding-right: 2rem;
  }

  .locked-signal h2 {
    margin: 0.45rem 0;
  }

  .locked-signal p {
    color: var(--ink-soft);
    font-size: 0.76rem;
    margin: 0;
  }

  .locked-values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-left: 2rem;
  }

  .locked-values span {
    align-items: center;
    border-bottom: 1px solid var(--rule);
    display: flex;
    font-size: 0.76rem;
    gap: 0.55rem;
    padding: 0.7rem;
  }

  .locked-values b {
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
  }

  .validation-gate {
    color: var(--main) !important;
    font-weight: 700;
    grid-column: 2;
    padding: 1rem 0 0 2rem;
  }

  .validation {
    border-bottom: 1px dotted var(--rule);
    padding: 4rem 0;
    scroll-margin-top: 2rem;
  }

  .validation > header {
    margin-bottom: 2rem;
  }

  .validation-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .validation-grid article {
    border-block: 1px solid var(--rule);
    min-height: 13rem;
    padding: 1.2rem;
  }

  .validation-grid article:first-child {
    padding-left: 0;
  }

  .validation-grid article + article {
    border-left: 1px solid var(--rule);
  }

  .validation-grid span {
    color: var(--main);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .validation-grid h3 {
    margin: 1.2rem 0 0.5rem;
  }

  .validation-grid p {
    color: var(--ink-soft);
    font-size: 0.74rem;
  }

  .boundary {
    padding: 4rem 0 1rem;
  }

  .boundary h2 {
    max-width: 52rem;
  }

  .boundary > div {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr 1fr;
    margin-top: 2rem;
    max-width: 58rem;
  }

  .boundary article {
    border-block: 1px solid var(--rule);
    padding: 1.3rem 1.5rem 1.3rem 0;
  }

  .boundary article + article {
    border-left: 1px solid var(--rule);
    padding-left: 1.5rem;
  }

  .boundary article p {
    color: var(--ink-soft);
    font-size: 0.78rem;
    margin: 0;
  }

  .boundary > a {
    align-items: center;
    display: inline-flex;
    font-family: var(--font-serif);
    font-weight: 700;
    gap: 0.35rem;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .signals {
      padding: 1.4rem 1rem 0;
    }

    .strategy-list article {
      grid-template-columns: 2rem 1fr auto;
      padding: 1.2rem 0;
    }

    .strategy-answer {
      grid-column: 2 / -1;
    }

    .strategy-cadence {
      grid-column: 2;
    }
  }

  @media (max-width: 700px) {
    .signals-hero h1 {
      font-size: 2.4rem;
    }

    .locked-signal,
    .validation-grid {
      display: block;
    }

    .locked-signal > div:first-child {
      border-bottom: 1px solid var(--rule);
      border-right: 0;
      padding: 0 0 1.4rem;
    }

    .locked-values {
      display: block;
      padding: 1rem 0 0;
    }

    .validation-gate {
      padding-left: 0;
    }

    .validation-grid article,
    .validation-grid article:first-child {
      min-height: 10rem;
      padding-inline: 0;
    }

    .validation-grid article + article {
      border-left: 0;
      border-top: 0;
    }

    .boundary > div {
      display: block;
    }

    .boundary article + article {
      border-left: 0;
      border-top: 0;
      padding-left: 0;
    }
  }
</style>
