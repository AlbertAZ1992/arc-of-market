---
import SolarIcon from "@/components/SolarIcon.astro";
import StrategySignalPreview from "@/components/StrategySignalPreview.astro";
import SiteShell from "@/layouts/SiteShell.astro";
import { loadSignalPublication } from "@/lib/signal-publication";
import { strategyLenses } from "@/lib/strategy-lenses";

const publication = loadSignalPublication();
const readingOrder = [
  ["01", "趋势", "计划输入价格、50 日和 200 日均线，输出扩张、观望或防守状态。"],
  ["02", "广度", "计划输入 50 日和 200 日广度与 VIX，检查指数涨跌的参与范围。"],
  ["03", "风格", "计划比较成长、价值和主要行业 ETF 的一周与一月相对回报。"],
  ["04", "周期", "计划按月比较资本开支、半导体回报和利率，标记技术投资阶段。"],
] as const;
---

<SiteShell
  bodyClass="signals-page"
  description="ArcOfMarket 用四个观察维度理解趋势、强弱、风格与长期周期。"
  title="Strategy Signals · ArcOfMarket"
>
  <main class="signals">
    <header class="signals-hero">
      <p class="eyebrow">STRATEGY SIGNALS · SUBSCRIBER PRODUCT</p>
      <h1>四项策略仍在定义和验证，<br />当前不发布信号值。</h1>
      <p>
        当前页面公开每项策略的输入范围、计划更新频率和可用数据区间。公式冻结并完成
        样本外验证后，订阅版才会提供方向、目标仓位、下一触发、失效条件和变更提醒。
      </p>
    </header>

    <StrategySignalPreview />

    <section class="strategy-list" aria-label="四个市场观察维度">
      {
        strategyLenses.map((strategy, index) => (
          <article>
            <span class="strategy-code">{String(index + 1).padStart(2, "0")}</span>
            <div class="strategy-name">
              <p>{strategy.code}</p>
              <h2>{strategy.title}</h2>
            </div>
            <p class="strategy-description">{strategy.description}</p>
            <div class="strategy-meta">
              <span>{strategy.dimension}</span>
              <strong>{strategy.cadence}</strong>
            </div>
          </article>
        ))
      }
    </section>

    <section class="product-boundary" aria-labelledby="boundary-title">
      <header>
        <p class="eyebrow">FREE VS SUBSCRIBER</p>
        <h2 id="boundary-title">免费页面公开研究依据，订阅版提供五项执行信息。</h2>
      </header>
      <div class="boundary-grid">
        <article>
          <span>公开可见</span>
          <h3>研究数据与计算口径</h3>
          <ul>
            <li>主要指数、广度、估值、风险与宏观图表</li>
            <li>模型覆盖范围、更新频率和研究样本</li>
            <li>数据来源、计算口径、限制条件</li>
          </ul>
        </article>
        <article class="boundary-grid__paid">
          <span>订阅后可见</span>
          <h3>当日信号与变更提醒</h3>
          <ul>
            {
              publication.lockedFields.map((field) => <li>{field}</li>)
            }
            <li>信号变更原因与及时提醒</li>
          </ul>
        </article>
      </div>
      <p class="boundary-status">
        当前状态：{publication.subscriptionEnabled
          ? "订阅入口已开放"
          : "公式尚未冻结，付费入口未开放。"}
      </p>
    </section>

    <section class="reading" aria-labelledby="reading-title">
      <header>
        <p class="eyebrow">HOW TO READ</p>
        <h2 id="reading-title">四项策略分别检查趋势、广度、风格和产业周期。</h2>
        <p>每项策略使用不同数据，不会把单一指标扩展成完整市场结论。</p>
      </header>
      <div class="reading-grid">
        {
          readingOrder.map(([code, title, description]) => (
            <article>
              <span>{code}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="signals-end">
      <div>
        <p class="eyebrow">THE MARKET MAP</p>
        <h2>查看当日市场数据、历史图表和现有计算方法。</h2>
        <p>
          首页列出最新价格、广度和风险读数；专题页保留完整历史；方法页说明已上线指标的口径。
        </p>
      </div>
      <nav aria-label="继续阅读">
        <a href="/">
          今日市场判断
          <SolarIcon name="arrow-right-linear" size={19} />
        </a>
        <a href="/archive/">
          全部图表
          <SolarIcon name="arrow-right-linear" size={19} />
        </a>
        <a href="/methodology/">
          计算方法
          <SolarIcon name="arrow-right-linear" size={19} />
        </a>
      </nav>
    </section>
  </main>

  <footer class="page-footer signals-footer">
    <span>© 2026 ArcOfMarket</span><span>·</span>
    <span>市场研究不构成个性化投资建议</span><span>·</span>
    <a href="/">返回今日市场判断</a>
  </footer>
</SiteShell>

<style>
  .signals {
    padding: 2rem 2.25rem 0 3rem;
  }

  .signals-hero {
    border-bottom: 1px dotted var(--rule);
    padding-bottom: 3.5rem;
  }

  .signals-hero h1 {
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 1.12;
    margin: 1.2rem 0 1.25rem;
    max-width: 68rem;
  }

  .signals-hero > p:last-child {
    color: var(--ink-soft);
    max-width: 48rem;
  }

  .strategy-list article {
    align-items: center;
    border-bottom: 1px dotted var(--rule);
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 3rem minmax(12rem, 0.75fr) minmax(20rem, 1.45fr) 9rem;
    min-height: 10rem;
  }

  .strategy-code {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .strategy-name p {
    color: var(--main);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .strategy-name h2 {
    font-size: 1.4rem;
    margin: 0.18rem 0 0;
  }

  .strategy-description {
    color: var(--ink-soft);
    font-size: 0.83rem;
    margin: 0;
    max-width: 36rem;
  }

  .strategy-meta {
    border-left: 1px solid var(--rule);
    display: grid;
    gap: 0.3rem;
    padding-left: 1.4rem;
  }

  .strategy-meta span,
  .strategy-meta strong {
    font-size: 0.68rem;
  }

  .strategy-meta span {
    color: var(--ink-faint);
  }

  .strategy-meta strong {
    font-family: var(--font-mono);
  }

  .product-boundary {
    border-bottom: 1px dotted var(--rule);
    padding: 4rem 0;
  }

  .product-boundary > header {
    max-width: 52rem;
  }

  .product-boundary h2 {
    margin: 0.55rem 0 1.5rem;
  }

  .boundary-grid {
    border-block: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .boundary-grid article {
    min-height: 14rem;
    padding: 1.4rem 1.5rem 1.4rem 0;
  }

  .boundary-grid article + article {
    border-left: 1px solid var(--rule);
    padding-left: 1.5rem;
  }

  .boundary-grid span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .boundary-grid h3 {
    font-size: 1rem;
    margin: 1.5rem 0 0.7rem;
  }

  .boundary-grid ul {
    color: var(--ink-soft);
    font-size: 0.76rem;
    line-height: 1.75;
    margin: 0;
    padding-left: 1rem;
  }

  .boundary-grid__paid {
    background: rgba(246, 12, 62, 0.035);
  }

  .boundary-grid__paid span {
    color: var(--main);
  }

  .boundary-status {
    color: var(--ink-faint);
    font-size: 0.68rem;
    margin: 0.8rem 0 0;
  }

  .reading {
    border-bottom: 1px dotted var(--rule);
    padding: 4rem 0;
  }

  .reading > header {
    margin-bottom: 2rem;
    max-width: 48rem;
  }

  .reading > header h2 {
    margin: 0.55rem 0;
  }

  .reading > header p:last-child {
    color: var(--ink-soft);
  }

  .reading-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .reading-grid article {
    border-block: 1px solid var(--rule);
    min-height: 12rem;
    padding: 1.25rem;
  }

  .reading-grid article:first-child {
    padding-left: 0;
  }

  .reading-grid article + article {
    border-left: 1px solid var(--rule);
  }

  .reading-grid span {
    color: var(--main);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .reading-grid h3 {
    margin: 1.4rem 0 0.55rem;
  }

  .reading-grid p {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .signals-end {
    align-items: end;
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.7fr);
    padding: 4rem 0 1rem;
  }

  .signals-end > div {
    max-width: 46rem;
  }

  .signals-end > div h2 {
    margin: 0.55rem 0;
  }

  .signals-end > div p:last-child {
    color: var(--ink-soft);
  }

  .signals-end nav {
    border-top: 1px solid var(--rule);
  }

  .signals-end nav a {
    align-items: center;
    border-bottom: 1px solid var(--rule);
    display: flex;
    font-family: var(--font-serif);
    font-weight: 700;
    justify-content: space-between;
    padding: 0.85rem 0;
  }

  @media (max-width: 900px) {
    .signals {
      padding: 1.4rem 1rem 0;
    }

    .strategy-list article {
      grid-template-columns: 2rem 1fr auto;
      padding: 1.4rem 0;
    }

    .strategy-description {
      grid-column: 2 / -1;
    }

    .strategy-meta {
      border-left: 0;
      grid-column: 2 / -1;
      grid-template-columns: auto auto;
      justify-content: start;
    }

    .boundary-grid {
      grid-template-columns: 1fr;
    }

    .boundary-grid article + article {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-left: 0;
    }
  }

  @media (max-width: 700px) {
    .signals-hero h1 {
      font-size: 2.7rem;
    }

    .reading-grid,
    .signals-end {
      display: block;
    }

    .reading-grid article,
    .reading-grid article:first-child {
      min-height: 9rem;
      padding-inline: 0;
    }

    .reading-grid article + article {
      border-left: 0;
      border-top: 0;
    }

    .signals-end nav {
      margin-top: 2rem;
    }
  }
</style>
