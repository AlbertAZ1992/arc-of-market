---
import ArcJsonChart from "@/components/charts/ArcJsonChart.astro";
import IndexResearchCharts from "@/components/charts/IndexResearchCharts.astro";
import Sp500Composition from "@/components/Sp500Composition.astro";
import ConstituentChanges from "@/components/tables/ConstituentChanges.astro";
import SiteShell from "@/layouts/SiteShell.astro";

const dockItems = [
  { href: "#sp500-century", label: "世纪尺度下的美股" },
  { href: "#sp500-total-return", label: "总回报指数" },
  { href: "#sp500-annual", label: "年度回报" },
  { href: "#sp500-bullbear", label: "牛熊周期" },
  { href: "#sp500-extremes", label: "极端交易日" },
  { href: "#sp500-distribution", label: "年度回报分布" },
  { href: "#sp500-holding", label: "持有期结果" },
  { href: "#sp500-rollmatrix", label: "多周期滚动回报" },
  { href: "#sp500-rolling5y", label: "五年年化回报" },
  { href: "#sp500-intrayear", label: "年内回撤与结果" },
  { href: "#sp500-seasonality", label: "月份季节性" },
  { href: "#sp500-drawdowns", label: "历史回撤" },
  { href: "#sp500-volatility", label: "实现与隐含波动" },
  { href: "#sp500-vol-family", label: "VIX 期限家族与 SKEW" },
  { href: "#sp500-cross-section", label: "市值 · 回报 · 指数权重" },
  { href: "#composition-title", label: "GICS 行业结构" },
  { href: "#directory-title", label: "当前成分目录" },
  { href: "#sp500-changes-chart", label: "调入与调出历史" },
] as const;
---

<SiteShell
  bodyClass="chart-page"
  description="从世纪回报、估值、回撤，到当前成分和调入调出记录。"
  pageNavigation={{ current: "S&P 500 市场编年史", items: dockItems }}
  title="S&P 500 市场编年史 · ArcOfMarket"
>
  <header class="page-header">
    <div class="page-header__inner">
      <p class="eyebrow">S&P 500 · MARKET HISTORY</p>
      <h1>从长期回报到五百家公司的新陈代谢</h1>
      <p class="muted">
        先看长期回报、估值和风险，再进入当前成分与指数调仓记录。
      </p>
    </div>
  </header>

  <main class="chart-main">
    <IndexResearchCharts index="sp500" />
    <Sp500Composition />
    <hr class="rule" />
    <ArcJsonChart
      dataPath="/data/sp500_changes.json"
      description="按生效年份汇总成分变更事件，再在下方查看逐笔加入、移除和公开原因。"
      id="sp500-changes-chart"
      kind="changes"
      source="Wikipedia 固定版本 · CC BY-SA 4.0"
      title="调入与调出的历史"
    />
    <ConstituentChanges />
  </main>

  <footer class="page-footer">
    <a href="/">返回首页</a><span>·</span>
    <a href="/methodology/">方法论</a><span>·</span>
    <a href="/terms/">服务条款</a>
  </footer>

</SiteShell>

<style>
  .chart-main {
    padding: 2.5rem 2.25rem 4.5rem 3rem;
  }

  @media (max-width: 900px) {
    .chart-main {
      padding: 1.5rem 1rem 3.5rem;
    }
  }
</style>
