---
import IndexResearchCharts from "@/components/charts/IndexResearchCharts.astro";
import Sp500Composition from "@/components/Sp500Composition.astro";
import { formatProse } from "@/content/format-prose";
import { pageContent } from "@/content/page-content";
import SiteShell from "@/layouts/SiteShell.astro";

const content = pageContent.sp500;
const dockItems = [
  { href: "#sp500-how-to-read", label: "看标普看什么" },
  { href: "#sp500-century", label: "世纪的形状" },
  { href: "#sp500-total-return", label: "总回报的真相" },
  { href: "#sp500-annual", label: "年度答卷" },
  { href: "#sp500-bullbear", label: "牛熊更替" },
  { href: "#sp500-extremes", label: "极端交易日" },
  { href: "#sp500-distribution", label: "回报分布" },
  { href: "#sp500-holding", label: "持有期真相" },
  { href: "#sp500-rollmatrix", label: "多周期视角" },
  { href: "#sp500-rolling5y", label: "五年滚动回报" },
  { href: "#sp500-intrayear", label: "年内回撤" },
  { href: "#sp500-seasonality", label: "月份季节性" },
  { href: "#sp500-drawdowns", label: "每次深跌都有名" },
  { href: "#sp500-volatility", label: "市场的呼吸" },
  { href: "#sp500-vol-family", label: "VIX 期限家族" },
  { href: "#sp500-cross-section", label: "五百家公司一张图" },
  { href: "#composition-title", label: "行业结构" },
  { href: "#directory-title", label: "当前成分目录" },
  { href: "#sp500-changes-chart", label: "指数新陈代谢" },
] as const;
---

<SiteShell
  bodyClass="chart-page"
  description={content.seo.description}
  pageNavigation={{ current: content.hero.eyebrow, items: dockItems }}
  title={content.seo.title}
>
  <header class="page-header">
    <div class="page-header__inner">
      <p class="eyebrow">{content.hero.eyebrow}</p>
      <h1>{content.hero.headline}</h1>
      <p class="muted" set:html={formatProse(content.hero.intro)} />
    </div>
  </header>

  <main class="chart-main">
    <!-- § 0 · 导读 -->
    <section class="how-to-read" id="sp500-how-to-read">
      <p class="chapter-label">HOW TO READ</p>
      <h2>怎么看这一页</h2>
      <div class="read-grid">
        <div>
          <h3>§ I · 回报的形状</h3>
          <p>
            先看长期价格、总回报和年度涨跌。你不需要预测明年——
            你只需要知道"长期持有大概是什么结果"。
            对数坐标下的长期趋势、牛熊周期的节奏、不同持有年限的胜率，
            这些比任何预测都更可靠。
          </p>
        </div>
        <div>
          <h3>§ II · 危机的节奏</h3>
          <p>
            再看回撤、波动和季节性。美股平均每年从高点回撤 14%，
            但多数年份年末仍收正。1929 年跌了 86%，
            2020 年只用五个月就收复了 34% 的跌幅。
            了解"最坏会怎样"，比猜"明年涨多少"有用得多。
          </p>
        </div>
        <div>
          <h3>§ III · 内部的骨骼</h3>
          <p>
            最后看指数里面有什么——五百家公司的横截面、十一大行业的权重、
            以及谁被踢出去、谁被加进来。S&P 500 不是静态的，
            它的成分在持续新陈代谢——这是它长期向上的底层机制。
          </p>
        </div>
      </div>
    </section>

    <IndexResearchCharts index="sp500" />

    <!-- § III · 内部结构 -->
    <section class="chapter-section" id="sp500-anatomy">
      <p class="chapter-label">§ III · INSIDE THE INDEX</p>
      <h2>五百家公司的内部结构</h2>
      <p class="chapter-desc">
        长期回报和危机节奏看完之后，打开指数看里面有什么。
      </p>
    </section>

    <Sp500Composition />

    <!-- § IV · 行业更替 -->
    <section class="chapter-section" id="sp500-industry-turnover">
      <p class="chapter-label">§ IV · THE METABOLISM</p>
      <h2>一百年前，这个指数里全是铁路</h2>
      <div class="turnover-story">
        <p>
          1900 年，铁路公司占了美国股市总市值的 <strong>63%</strong>。
          今天，铁路不到 <strong>1%</strong>。科技和健康医疗从零变成了接近一半。
        </p>
        <p>
          <strong>这就是指数不死的原因。</strong>它不是选最好的一批公司然后永远不变——
          它是一套新陈代谢系统。铁路被汽车和飞机取代，钢铁被半导体取代，
          百货被电商取代。每一次被淘汰的公司退出，新一批公司进入——
          指数的长期回报来自这场永不停歇的创造性破坏。
        </p>
        <p>
          1970 年代的 Nifty Fifty（柯达、宝丽来、施乐）曾被认为"一次买入、永不卖出"，
          1973-74 年熊市平均跌了 60%+。2000 年的 Cisco 曾是全球市值最高的公司（PE 140 倍），
          今天股价还没回到 2000 年的高点。2023 年的 Mag7 是今天的主角——
          二十年后会有人在它们的位置上。
        </p>
        <p class="turnover-tagline">
          <strong>S&P 500 从来不靠"选出赢家"，靠的是"让输家自动退出"。</strong>
        </p>
      </div>
    </section>

    <!-- § V · 教育拓展模块入口 -->
    <section class="chapter-section" id="sp500-education">
      <p class="chapter-label">§ V · FRAMEWORKS</p>
      <h2>用历史框架理解现在</h2>
      <p class="chapter-desc">
        数据看完了。如果你想把看到的模式和更系统的理论框架联系起来——
        这些是我们准备拓展的模块。有些已经可用，有些正在建设中。
      </p>
      <div class="edu-modules">
        <div class="edu-module edu-module--coming">
          <strong>佩雷斯产业周期</strong>
          <span class="edu-badge">即将推出</span>
          <p>Carlota Perez 的五次技术革命框架：从铁路到芯片到 AI，每次 50-60 年的大周期，如何解释当前 AI 浪潮的位置。</p>
        </div>
        <div class="edu-module edu-module--coming">
          <strong>21 世纪货币政策</strong>
          <span class="edu-badge">即将推出</span>
          <p>Ben Bernanke 的解释框架：2008 年后的量化宽松、2020 年的无限 QE、2022 年的暴力加息——用央行的视角理解市场。</p>
        </div>
        <div class="edu-module">
          <strong>美股百年牛熊全史</strong>
          <span class="edu-badge">已有</span>
          <p>本页 § I–III 已经覆盖：1929 大萧条、1970s 滞胀、1987 黑色星期一、2000 dotcom、2008 GFC、2020 COVID。</p>
          <a href="#sp500-drawdowns">跳转到历史回撤 →</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="page-footer">
    <a href="/">返回首页</a><span>·</span>
    <a href="/nasdaq/">纳斯达克</a><span>·</span>
    <a href="/dow/">道琼斯</a><span>·</span>
    <a href="/magnificent-seven/">七巨头</a><span>·</span>
    <a href="/methodology/">方法论</a>
  </footer>

</SiteShell>

<style>
  .chart-main {
    padding: 2.5rem 2.25rem 4.5rem 3rem;
  }

  .how-to-read {
    border-bottom: 1px solid var(--ink);
    padding-block: 1.5rem 2.5rem;
    scroll-margin-top: 6rem;
  }

  .chapter-label {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .how-to-read h2 {
    margin: 0.35rem 0 1.5rem;
  }

  .read-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .read-grid h3 {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    margin-bottom: 0.5rem;
  }

  .read-grid p {
    color: var(--ink-soft);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .chapter-section {
    border-bottom: 1px solid var(--ink);
    padding-block: 3rem 2rem;
    scroll-margin-top: 6rem;
  }

  .chapter-section h2 {
    margin: 0.35rem 0 0.4rem;
  }

  .chapter-desc {
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  .turnover-story {
    max-width: 48rem;
  }

  .turnover-story p {
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.75;
    margin-bottom: 0.8rem;
  }

  .turnover-tagline {
    background: rgba(246, 12, 62, 0.04);
    border-left: 3px solid var(--main);
    font-size: 0.88rem !important;
    padding: 0.8rem 1rem;
    margin-top: 1.5rem !important;
  }

  .edu-modules {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1.5rem;
    max-width: 56rem;
  }

  .edu-module {
    border: 1px solid var(--rule);
    padding: 1rem 1.1rem;
    position: relative;
  }

  .edu-module--coming {
    opacity: 0.6;
  }

  .edu-module strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 0.88rem;
    margin-bottom: 0.3rem;
  }

  .edu-badge {
    background: var(--ink);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.4rem;
    position: absolute;
    right: 0.8rem;
    top: 0.8rem;
    text-transform: uppercase;
  }

  .edu-module--coming .edu-badge {
    background: var(--rule);
    color: var(--ink-faint);
  }

  .edu-module p {
    color: var(--ink-faint);
    font-size: 0.72rem;
    line-height: 1.6;
    margin: 0.3rem 0 0;
  }

  .edu-module a {
    color: var(--main);
    font-size: 0.7rem;
  }

  @media (max-width: 900px) {
    .chart-main {
      padding: 1.5rem 1rem 3.5rem;
    }

    .read-grid {
      grid-template-columns: 1fr;
    }

    .edu-modules {
      grid-template-columns: 1fr;
    }
  }
</style>
