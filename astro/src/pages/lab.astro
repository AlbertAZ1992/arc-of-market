---
import MarketProxyCharts from "@/components/MarketProxyCharts.astro";
import SolarIcon from "@/components/SolarIcon.astro";
import FinancialStressChart from "@/components/charts/FinancialStressChart.astro";
import TradingViewHeatmap from "@/components/charts/TradingViewHeatmap.astro";
import SiteShell from "@/layouts/SiteShell.astro";

const projects = [
  {
    date: "2026.07",
    icon: "database-linear",
    label: "DATA FOUNDATION",
    title: "数据来源目录",
    description:
      "把宏观、指数与风险数据放进同一份地图，快速找到每张图的来源和最近日期。",
    metrics: [["范围", "宏观 · 指数"], ["来源", "FRED · OFR · CFTC"], ["频率", "每日"]],
    href: "/methodology/",
  },
  {
    date: "2026.08",
    icon: "chart-2-linear",
    label: "MARKET ARCHIVE",
    title: "百年市场档案",
    description:
      "把年度回报、回撤、滚动收益和衰退区间做成长期坐标，比较今天与过去的相似和不同。",
    metrics: [["跨度", "近百年"], ["范围", "SPX · NDX"], ["视角", "回报 · 风险"]],
    href: "/archive/",
  },
  {
    date: "2026.08",
    icon: "buildings-2-linear",
    label: "INDEX STRUCTURE",
    title: "指数的新陈代谢",
    description:
      "记录当前行业结构与成分变更，观察一家公司如何进入或离开主要指数。",
    metrics: [["记录", "406"], ["维度", "调入 · 调出"], ["范围", "S&P 500"]],
    href: "/sp500/",
  },
  {
    date: "2026.08",
    icon: "round-graph-linear",
    label: "ROTATION",
    title: "ETF 相对强度与轮动",
    description:
      "比较主要市场与行业 ETF 的相对强弱，观察资金偏好正在向哪里移动。",
    metrics: [["视角", "成长 · 价值"], ["资产", "ETF"], ["输出", "相对强度"]],
    href: "/themes/information-technology/",
  },
] as const;

const dockItems = [
  { href: "#market-environment", label: "市场环境总览" },
  { href: "#market-index-etfs", label: "主要指数与 ETF" },
  { href: "#market-heatmap", label: "市值加权热力图" },
] as const;
---

<SiteShell
  bodyClass="lab-page"
  description="ArcOfMarket 的数据、图表和原创指标实验记录。"
  pageNavigation={{ current: "Arc Lab", items: dockItems }}
  title="Lab · ArcOfMarket"
>
  <main class="lab">
    <header class="lab-header">
      <p class="eyebrow">ARC.LAB · 研究实验室</p>
      <h1>每一项研究，<br />都留下它是怎么长出来的。</h1>
      <p>
        Lab 把长期数据、市场结构和原创读数放在一起。每个项目从一个市场问题出发，
        给出对应的数据、图表和阅读方式。
      </p>
    </header>

    <section class="lab-timeline" aria-label="研究时间线">
      {
        projects.map((project, index) => (
          <article class:list={{ reverse: index % 2 === 1 }}>
            <div class="lab-date">{project.date}</div>
            <div class="lab-node"><i></i></div>
            <div class="lab-card">
              <header>
                <SolarIcon name={project.icon} size={26} />
                <span>{project.label}</span>
              </header>
              <h2>{project.title}</h2>
              <p>{project.description}</p>
              <dl>
                {project.metrics.map(([label, value]) => (
                  <div><dt>{label}</dt><dd>{value}</dd></div>
                ))}
              </dl>
              <a href={project.href}>查看当前成果 →</a>
            </div>
          </article>
        ))
      }
    </section>

    <section class="lab-chart-intro">
      <p class="eyebrow">MARKET DESK</p>
      <h2>从市场全景到原创指标</h2>
      <p>
        先建立可复核的市场底图，再计算环境、宽度、相对强弱和信号台账。
        每一项目录都对应下面的独立组件。
      </p>
    </section>

    <div class="lab-charts">
      <section class="lab-component" id="market-environment">
        <FinancialStressChart />
      </section>
      <section class="lab-component" id="market-index-etfs">
        <MarketProxyCharts />
      </section>
      <TradingViewHeatmap
        dataSource="SPX500"
        description="按当前市值和涨跌幅观察 S&P 500 横截面，点击公司可查看明细。"
        id="market-heatmap"
        title="市值加权热力图"
      />
    </div>

    <section class="lab-note">
      <p class="eyebrow">OPEN NOTEBOOK</p>
      <h2>同一个市场问题，可以从不同时间尺度观察。</h2>
      <p>
        短期看价格和波动，中期看风格与行业，长期看估值和产业周期。
        Lab 会持续把这些视角连接成一张完整的市场地图。
      </p>
      <a href="/methodology/">查看计算方法 →</a>
    </section>
  </main>

  <footer class="page-footer">
    <span>Arc Lab · Open notebook</span><span>·</span>
    <a href="/archive/">全部图表</a>
  </footer>

</SiteShell>

<style>
  .lab {
    padding: 2rem 2.25rem 0 3rem;
  }

  .lab-header {
    border-bottom: 1px dotted var(--rule);
    padding-bottom: 2.4rem;
    text-align: center;
  }

  .lab-header h1 {
    font-size: 2.05rem;
    line-height: 1.25;
    margin: 0.8rem auto;
    max-width: 66rem;
  }

  .lab-header > p:last-child {
    color: var(--ink-soft);
    margin-inline: auto;
    max-width: 44rem;
  }

  .lab-timeline {
    margin-inline: auto;
    max-width: 74rem;
    padding: 4rem 0;
  }

  .lab-timeline article {
    display: grid;
    grid-template-columns: 1fr 4rem 1fr;
    min-height: 19rem;
  }

  .lab-date {
    align-self: start;
    color: var(--main);
    font-family: var(--font-mono);
    font-size: 0.73rem;
    padding-top: 1rem;
    text-align: right;
  }

  .lab-node {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .lab-node::before {
    border-left: 1px solid var(--main);
    bottom: 0;
    content: "";
    left: 50%;
    position: absolute;
    top: 0;
  }

  .lab-node i {
    background: var(--main);
    border: 0.42rem solid #fff;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--main);
    height: 1rem;
    margin-top: 0.9rem;
    position: relative;
    width: 1rem;
    z-index: 1;
  }

  .lab-card {
    border-top: 1px dotted var(--rule);
    padding: 0.8rem 0 2.5rem;
  }

  .lab-card > header {
    align-items: center;
    color: var(--main);
    display: flex;
    gap: 0.55rem;
  }

  .lab-card > header span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .lab-card h2 {
    margin: 0.8rem 0 0.6rem;
  }

  .lab-card > p {
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  .lab-card dl {
    border-bottom: 1px dotted var(--rule);
    border-top: 1px dotted var(--rule);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 1.2rem 0;
  }

  .lab-card dl > div {
    border-right: 1px dotted var(--rule);
    padding: 0.5rem;
  }

  .lab-card dl > div:last-child {
    border-right: 0;
  }

  .lab-card dt {
    color: var(--ink-faint);
    font-size: 0.58rem;
  }

  .lab-card dd {
    color: var(--main);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    margin: 0.1rem 0 0;
  }

  .lab-card > a {
    border-bottom: 1px dotted var(--ink-faint);
    font-size: 0.68rem;
  }

  .lab-timeline article:not(.reverse) .lab-card {
    grid-column: 3;
  }

  .lab-timeline article.reverse .lab-date {
    grid-column: 3;
    text-align: left;
  }

  .lab-timeline article.reverse .lab-node {
    grid-column: 2;
    grid-row: 1;
  }

  .lab-timeline article.reverse .lab-card {
    grid-column: 1;
    grid-row: 1;
  }

  .lab-note {
    border-bottom: 1px dotted var(--rule);
    border-top: 1px dotted var(--rule);
    margin-inline: auto;
    max-width: 52rem;
    padding: 4rem 0;
    text-align: center;
  }

  .lab-chart-intro {
    border-block: 1px dotted var(--rule);
    margin: 0 auto;
    max-width: 74rem;
    padding-block: 3.5rem;
    text-align: center;
  }

  .lab-chart-intro h2 {
    margin: 0.45rem 0 0.75rem;
  }

  .lab-chart-intro p:last-child {
    color: var(--ink-soft);
    margin-inline: auto;
    max-width: 46rem;
  }

  .lab-charts {
    margin-inline: auto;
    max-width: 78rem;
  }

  .lab-component {
    scroll-margin-top: 6rem;
  }

  .lab-note p:not(.eyebrow) {
    color: var(--ink-soft);
  }

  .lab-note a {
    border-bottom: 1px dotted var(--ink-faint);
    font-size: 0.72rem;
  }

  @media (max-width: 700px) {
    .lab {
      padding: 1.3rem 1rem 0;
    }

    .lab-header {
      padding-bottom: 2.5rem;
    }

    .lab-header h1 {
      font-size: 1.95rem;
    }

    .lab-timeline {
      padding: 2.5rem 0;
    }

    .lab-timeline article {
      grid-template-columns: 2.5rem 1fr;
      min-height: 0;
    }

    .lab-date,
    .lab-timeline article.reverse .lab-date {
      grid-column: 2;
      grid-row: 1;
      padding-bottom: 0.6rem;
      text-align: left;
    }

    .lab-node,
    .lab-timeline article.reverse .lab-node {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .lab-card,
    .lab-timeline article:not(.reverse) .lab-card,
    .lab-timeline article.reverse .lab-card {
      grid-column: 2;
      grid-row: 2;
      margin-bottom: 2.5rem;
    }
  }
</style>
