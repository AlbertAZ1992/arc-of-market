---
import ThemeResearchCharts from "@/components/charts/ThemeResearchCharts.astro";
import TradingViewSymbolOverview from "@/components/TradingViewSymbolOverview.astro";
import SiteShell from "@/layouts/SiteShell.astro";
import type { MarketTheme } from "@/lib/market-themes";
import { marketThemes } from "@/lib/market-themes";

export function getStaticPaths() {
  return marketThemes.map((theme) => ({
    params: { slug: theme.slug },
    props: { theme },
  }));
}

type Props = {
  theme: MarketTheme;
};

const { theme } = Astro.props;
const dockItems = theme.groups.map((group, index) => ({
  href: `#theme-group-${index + 1}`,
  label: group.heading,
}));
const comparisonItems = [
  ...(theme.slug === "consumer"
    ? [{ href: "#consumer-xlp-xly", label: "XLP × XLY" }]
    : []),
  ...(theme.slug === "financials"
    ? [{ href: "#financial-crisis-2008", label: "2008 金融危机" }]
    : []),
];
const allDockItems = [...dockItems, ...comparisonItems];
---

<SiteShell
  bodyClass="chart-page"
  description={theme.description}
  pageNavigation={{ current: theme.title, items: allDockItems }}
  title={`${theme.title} · ArcOfMarket`}
>
  <header class="page-header">
    <div class="page-header__inner">
      <p class="eyebrow">{theme.eyebrow}</p>
      <h1>{theme.title}</h1>
      <p class="muted">{theme.description}</p>
    </div>
  </header>

  <main class="theme-main">
    {
      theme.groups.map((group, index) => (
        <section class="theme-section" id={`theme-group-${index + 1}`}>
          <div class="theme-copy">
            <p class="eyebrow">{String(index + 1).padStart(2, "0")} · MARKET PROXY</p>
            <h2>{group.heading}</h2>
            <p class="muted">{group.description}</p>
          </div>
          <TradingViewSymbolOverview
            label={`${theme.title} · ${group.heading}`}
            symbols={group.symbols}
          />
        </section>
      ))
    }
    <ThemeResearchCharts slug={theme.slug} />

    <section class="method-note">
      <h2>这一页如何使用</h2>
      <p class="muted">
        图表由 TradingView 官方组件直接展示，ArcOfMarket 不下载、缓存或转售组件中的行情，
        也不把组件数据用于自研指标计算。ETF 是板块代理，不等于官方行业指数。
      </p>
    </section>
  </main>

  <footer class="page-footer">
    <a href="/">返回首页</a><span>·</span>
    <a href="/methodology/">方法论</a><span>·</span>
    <a href="/terms/">服务条款</a>
  </footer>

</SiteShell>

<style>
  .theme-main {
    padding: 0 2.25rem 4.5rem 3rem;
  }

  .theme-section {
    border-bottom: 1px dotted var(--rule);
    padding-block: 3.5rem;
  }

  .theme-copy {
    margin-bottom: 1.5rem;
    max-width: 46rem;
  }

  .theme-copy h2 {
    margin-bottom: 0.6rem;
  }

  .method-note {
    margin-block: 4rem;
    max-width: 46rem;
  }

  @media (max-width: 900px) {
    .theme-main {
      padding: 0 1rem 3.5rem;
    }
  }
</style>
