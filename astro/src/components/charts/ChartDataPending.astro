---
type Props = {
  description: string;
  id: string;
  source: string;
  title: string;
};

const { description, id, source, title } = Astro.props;
---

<section class="pending-chart" id={id}>
  <header>
    <p class="eyebrow">DATA SERIES</p>
    <h2>{title}</h2>
    <p>{description}</p>
  </header>
  <div aria-label={`${title}数据状态`} class="pending-chart__surface" role="status">
    <strong>这项图表已进入页面</strong>
    <p>当前数据更新中；数据文件生成后会在同一位置自动显示历史图。</p>
  </div>
  <footer>计划来源：{source}</footer>
</section>

<style>
  .pending-chart {
    border-bottom: 1px dotted var(--rule);
    padding-block: 3.5rem;
    scroll-margin-top: 6rem;
  }

  .pending-chart > header {
    margin-bottom: 1.35rem;
    max-width: 48rem;
  }

  .pending-chart h2 {
    margin: 0.35rem 0 0.6rem;
  }

  .pending-chart header > p:last-child,
  .pending-chart__surface p {
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .pending-chart__surface {
    align-content: center;
    border-block: 1px dotted var(--rule);
    display: grid;
    min-height: 18rem;
    padding: 2rem;
  }

  .pending-chart__surface strong {
    font-family: var(--font-serif);
    font-size: 1.25rem;
  }

  .pending-chart footer {
    color: var(--ink-faint);
    font-size: 0.62rem;
    padding-top: 0.75rem;
  }
</style>
