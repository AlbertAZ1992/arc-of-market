---
import type { ArcChartSpec } from "@/lib/arc-chart-types";

type Props = ArcChartSpec;

const {
  dataPath,
  description,
  eyebrow = "HISTORICAL VIEW",
  id,
  interpretation,
  kind,
  note,
  scaleType,
  series,
  source,
  title,
  valueKey,
  valueLabel,
  whatToWatch,
  yUnit,
} = Astro.props;
---

<section class="arc-chart-section" id={id}>
  <header>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p>{description}</p>
  </header>
  <div
    aria-label={`${title}图表`}
    class="arc-json-chart"
    data-arc-json-chart
    data-data-path={dataPath}
    data-kind={kind}
    data-scale-type={scaleType}
    data-series={series ? JSON.stringify(series) : undefined}
    data-value-key={valueKey}
    data-value-label={valueLabel}
    data-y-unit={yUnit}
    role="img"
  >
    <p data-chart-status>正在读取图表数据…</p>
  </div>
  {
    interpretation && interpretation.length > 0 && (
      <div class="chart-narrative">
        <div class="chart-narrative__reading">
          <h4>当前图表表达了什么</h4>
          <ul>
            {interpretation.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        {
          whatToWatch && whatToWatch.length > 0 && (
            <div class="chart-narrative__watch">
              <h4>应该关注什么</h4>
              <ul>
                {whatToWatch.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )
        }
      </div>
    )
  }
  <footer>
    <span>来源：{source}</span>
    {note && <span>{note}</span>}
  </footer>
</section>

<script>
  import { bootArcJsonCharts } from "@/lib/arc-json-chart";

  bootArcJsonCharts();
</script>

<style>
  .arc-chart-section {
    border-bottom: 1px dotted var(--rule);
    scroll-margin-top: 6rem;
    padding-block: 3.5rem;
  }

  .arc-chart-section > header {
    margin-bottom: 1.35rem;
    max-width: 48rem;
  }

  .arc-chart-section h2 {
    margin: 0.35rem 0 0.6rem;
  }

  .arc-chart-section header > p:last-child {
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .arc-json-chart {
    height: 28rem;
    min-width: 0;
    width: 100%;
  }

  .arc-json-chart [data-chart-status] {
    align-items: center;
    border-block: 1px dotted var(--rule);
    color: var(--ink-faint);
    display: flex;
    font-size: 0.72rem;
    height: 100%;
    justify-content: center;
  }

  .chart-narrative {
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr 1fr;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
  }

  .chart-narrative h4 {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-weight: 700;
    margin: 0 0 0.65rem;
  }

  .chart-narrative ul {
    display: grid;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chart-narrative li {
    color: var(--ink-soft);
    font-size: 0.74rem;
    line-height: 1.55;
    padding-left: 1rem;
    position: relative;
  }

  .chart-narrative li::before {
    color: var(--main);
    content: "—";
    left: 0;
    position: absolute;
  }

  .chart-narrative__reading {
    border-right: 1px solid var(--rule);
    padding-right: 2rem;
  }

  .arc-chart-section footer {
    border-top: 1px dotted var(--rule);
    color: var(--ink-faint);
    display: flex;
    font-size: 0.62rem;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 1.5rem;
    padding-top: 0.75rem;
  }

  @media (max-width: 640px) {
    .arc-chart-section {
      padding-block: 2.6rem;
    }

    .arc-json-chart {
      height: 23rem;
    }

    .chart-narrative {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .chart-narrative__reading {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding-bottom: 1.2rem;
      padding-right: 0;
    }

    .arc-chart-section footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
