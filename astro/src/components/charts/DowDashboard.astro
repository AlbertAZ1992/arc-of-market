---
// Dow Jones dashboard — DJI century chart, ETF proxy comparison
---

<section class="dow-dashboard" aria-labelledby="dow-dashboard-title">
  <!-- § I · 蓝筹基因 -->
  <section class="dow-chapter" id="dow-blue-chips">
    <div class="chapter-intro">
      <p class="chapter-label">§ I · BLUE CHIP DNA</p>
      <h2>道琼斯：美国蓝筹的百年坐标</h2>
      <p>
        道琼斯工业平均指数始于 1896 年，只包含 30 家公司——但它选的是美国
        最具代表性的蓝筹企业。跟 S&P 500 的 500 家或纳斯达克的数千家不同，
        道琼斯更偏重工业、金融和消费这些"实体经济"部门，科技股权重相对较低。
      </p>
      <p class="guide">
        怎么看：道琼斯代表的是"旧经济"蓝筹，S&P 500 是"全市场"，
        Nasdaq-100 是"新经济"。三者的走势差异反映了市场风格的轮动。
        当你看到 Nasdaq-100 大幅跑赢道琼斯时，通常是科技/AI 主题主导市场；
        当道琼斯领涨时，往往是价值股和周期股在表现。
      </p>
    </div>
    <div
      id="dow-etf-chart"
      class="dow-chart"
      role="img"
      aria-label="道琼斯 DIA、标普 500 SPY、纳斯达克 100 QQQ 归一化对比"
    >
      <p data-chart-status>正在读取数据…</p>
    </div>
  </section>

  <!-- § II · 道琼斯长期价格 -->
  <section class="dow-chapter" id="dow-century">
    <div class="chapter-intro">
      <p class="chapter-label">§ II · THE LONG ARC</p>
      <h2>道琼斯指数的世纪之旅</h2>
      <p>
        从 1900 年代的 66 点到今天的三万点以上，道琼斯见证了两场世界大战、
        大萧条、互联网泡沫、金融危机和疫情。对数坐标下，长期趋势一目了然。
      </p>
    </div>
    <div
      id="dow-price-chart"
      class="dow-chart"
      role="img"
      aria-label="道琼斯工业平均指数长期价格历史"
    >
      <p data-chart-status>正在读取数据…</p>
    </div>
  </section>

  <!-- § III · 年度回报 -->
  <section class="dow-chapter" id="dow-annual">
    <div class="chapter-intro">
      <p class="chapter-label">§ III · YEAR BY YEAR</p>
      <h2>道琼斯每年给投资者交出了什么答卷</h2>
      <p>
        每个自然年的涨跌一目了然。绿色是赚，红色是亏。
        注意道琼斯跟 S&P 500 的年度回报虽高度相关但不完全相同——
        30 只股票和 500 只股票在不同年份的行业暴露差异会产生偏离。
      </p>
    </div>
    <div
      id="dow-annual-chart"
      class="dow-chart"
      role="img"
      aria-label="道琼斯年度回报柱状图"
    >
      <p data-chart-status>正在读取数据…</p>
    </div>
  </section>

  <!-- § IV · 历史回撤 -->
  <section class="dow-chapter" id="dow-drawdowns">
    <div class="chapter-intro">
      <p class="chapter-label">§ IV · THE FALLS</p>
      <h2>道琼斯经历过的每一次深跌</h2>
      <p>
        大萧条时期道琼斯跌掉了近 90%——这个数字至今仍是美股历史上最深的伤疤。
        2008 年金融危机中，道琼斯里的金融股首当其冲。了解历史回撤的深度和
        恢复时间，比看任何预测都更能帮你做好心理准备。
      </p>
    </div>
    <div
      id="dow-dd-chart"
      class="dow-chart"
      role="img"
      aria-label="道琼斯历史回撤"
    >
      <p data-chart-status>正在读取数据…</p>
    </div>
  </section>
</section>

<script>
  import { LineChart, BarChart } from "echarts/charts";
  import {
    GridComponent,
    LegendComponent,
    TooltipComponent,
  } from "echarts/components";
  import * as echarts from "echarts/core";
  import { CanvasRenderer } from "echarts/renderers";
  import {
    ARC_ECHARTS_THEME,
    ARC_ECHARTS_THEME_DARK,
  } from "../../lib/echarts-theme";

  echarts.use([
    BarChart,
    LineChart,
    GridComponent,
    LegendComponent,
    TooltipComponent,
    CanvasRenderer,
  ]);
  echarts.registerTheme("arc", ARC_ECHARTS_THEME);
  echarts.registerTheme("arc-dark", ARC_ECHARTS_THEME_DARK);

  const theme = window.matchMedia("(prefers-color-scheme: dark)").matches
    ? "arc-dark"
    : "arc";

  const positive = "#00a487";
  const negative = "#f60c3e";

  function renderETFProxies(data: any) {
    const el = document.getElementById("dow-etf-chart");
    if (!el) return;
    el.querySelector("[data-chart-status]")?.remove();
    const dates = data.dates as string[];
    const series = data.series as Record<string, { label: string; values: number[] }>;
    const colors: Record<string, string> = { DIA: negative, SPY: "#989898", QQQ: "#4d6ea9" };
    const chart = echarts.init(el, theme);
    chart.setOption({
      animation: false,
      legend: { data: Object.values(series).map((s: any) => s.label) },
      tooltip: { trigger: "axis", valueFormatter: (v: number) => v.toFixed(1) },
      xAxis: { type: "category", data: dates },
      yAxis: { type: "value", name: "归一化（起点=100）" },
      series: Object.entries(series).map(([ticker, info]: [string, any]) => ({
        name: info.label,
        type: "line",
        data: info.values,
        lineStyle: { color: colors[ticker] ?? "#989898", width: ticker === "DIA" ? 2 : 1.4 },
        showSymbol: false,
        sampling: "lttb",
      })),
      grid: { bottom: 52, containLabel: true, left: 12, right: 18, top: 52 },
    });
    new ResizeObserver(() => chart.resize()).observe(el);
  }

  function renderPrice(data: any) {
    const el = document.getElementById("dow-price-chart");
    if (!el) return;
    el.querySelector("[data-chart-status]")?.remove();
    const chart = echarts.init(el, theme);
    chart.setOption({
      animation: false,
      tooltip: { trigger: "axis", valueFormatter: (v: number) => v.toLocaleString() },
      xAxis: { type: "category", data: data.dates as string[] },
      yAxis: { type: "log", name: "指数点位（对数坐标）" },
      series: [{
        name: "道琼斯", type: "line",
        data: data.close as number[],
        areaStyle: { color: "rgba(246,12,62,0.06)" },
        lineStyle: { color: negative, width: 1.5 },
        showSymbol: false, sampling: "lttb",
      }],
      grid: { bottom: 52, containLabel: true, left: 12, right: 18, top: 52 },
    });
    new ResizeObserver(() => chart.resize()).observe(el);
  }

  function renderAnnual(data: any) {
    const el = document.getElementById("dow-annual-chart");
    if (!el) return;
    el.querySelector("[data-chart-status]")?.remove();
    const rets = data.returns as number[];
    const years = data.years as string[];
    const chart = echarts.init(el, theme);
    chart.setOption({
      animation: false,
      tooltip: { trigger: "axis", valueFormatter: (v: number) => `${v}%` },
      xAxis: { type: "category", data: years },
      yAxis: { type: "value", name: "%" },
      series: [{
        name: "年度回报", type: "bar",
        data: rets.map((v: number) => ({
          value: v,
          itemStyle: { color: v >= 0 ? positive : negative },
        })),
      }],
      grid: { bottom: 52, containLabel: true, left: 12, right: 18, top: 52 },
    });
    new ResizeObserver(() => chart.resize()).observe(el);
  }

  function renderDrawdowns(data: any) {
    const el = document.getElementById("dow-dd-chart");
    if (!el) return;
    el.querySelector("[data-chart-status]")?.remove();
    const chart = echarts.init(el, theme);
    chart.setOption({
      animation: false,
      tooltip: { trigger: "axis", valueFormatter: (v: number) => `${v}%` },
      xAxis: { type: "category", data: data.dates as string[] },
      yAxis: { type: "value", name: "%", max: 0 },
      series: [{
        name: "回撤", type: "line",
        data: data.dd as number[],
        areaStyle: { color: "rgba(246,12,62,0.1)" },
        lineStyle: { color: negative, width: 1.4 },
        showSymbol: false, sampling: "lttb",
      }],
      grid: { bottom: 52, containLabel: true, left: 12, right: 18, top: 52 },
    });
    new ResizeObserver(() => chart.resize()).observe(el);
  }

  async function boot() {
    const [etfRes, priceRes, annualRes, ddRes] = await Promise.all([
      fetch("/data/etf_proxies.json"),
      fetch("/data/dji_century.json"),
      fetch("/data/dji_annual.json"),
      fetch("/data/dji_drawdowns.json"),
    ]);
    if (!etfRes.ok || !priceRes.ok) {
      document.querySelectorAll("[data-chart-status]").forEach(el => {
        el.textContent = "数据暂不可用";
      });
      return;
    }
    const [etf, price, annual, dd] = await Promise.all([
      etfRes.json(), priceRes.json(),
      annualRes.ok ? annualRes.json() : null,
      ddRes.ok ? ddRes.json() : null,
    ]);
    renderETFProxies(etf);
    renderPrice(price);
    if (annual) renderAnnual(annual);
    if (dd) renderDrawdowns(dd);
  }

  boot().catch((e: unknown) => {
    document.querySelectorAll("[data-chart-status]").forEach(el => {
      el.textContent = `数据读取失败：${String(e)}`;
    });
  });
</script>

<style>
  .dow-dashboard {
    margin-block: var(--space-section);
  }

  .dow-chapter {
    border-top: 1px solid var(--rule);
    padding-block: 3.5rem;
    scroll-margin-top: 6rem;
  }

  .dow-chapter:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .chapter-intro {
    margin-bottom: 2rem;
    max-width: 48rem;
  }

  .chapter-label {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .chapter-intro h2 {
    font-size: 1.45rem;
    margin: 0.35rem 0 0.75rem;
  }

  .chapter-intro > p {
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.7;
    margin-bottom: 0.65rem;
  }

  .guide {
    background: rgba(246, 12, 62, 0.04);
    border-left: 3px solid var(--main);
    color: var(--ink-soft);
    font-size: 0.78rem !important;
    line-height: 1.65;
    padding: 0.65rem 1rem;
  }

  .dow-chart {
    height: 28rem;
    min-width: 0;
    width: 100%;
  }

  .dow-chart [data-chart-status] {
    align-items: center;
    border-block: 1px dotted var(--rule);
    color: var(--ink-faint);
    display: flex;
    font-size: 0.72rem;
    height: 100%;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .dow-chapter {
      padding-block: 2.6rem;
    }

    .dow-chart {
      height: 23rem;
    }
  }
</style>
