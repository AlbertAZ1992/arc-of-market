---
import SolarIcon from "@/components/SolarIcon.astro";

const path = Astro.url.pathname;
const links = [
  { href: "/", icon: "home-2-linear", label: "首页", match: path === "/" },
  {
    href: "/archive/",
    icon: "archive-linear",
    label: "全部图表",
    match: path.startsWith("/archive"),
  },
  {
    href: "/about/",
    icon: "info-circle-linear",
    label: "关于",
    match: path.startsWith("/about"),
  },
] as const;

const researchLinks = [
  { href: "/macro/", label: "宏观环境" },
  { href: "/sp500/", label: "标普 500" },
  { href: "/nasdaq/", label: "纳斯达克" },
  { href: "/dow/", label: "道琼斯" },
  { href: "/magnificent-seven/", label: "七巨头" },
  { href: "/sectors/", label: "行业板块" },
  { href: "/lab/", label: "实验室指标" },
  { href: "/methodology/", label: "方法论" },
] as const;
---

<div aria-hidden="true" class="site-frame">
  <i></i><i></i><i></i>
</div>

<header class="mobile-header">
  <a aria-label="ArcOfMarket 首页" class="mobile-brand" href="/">
    <span>ARC</span><span>OF MARKET</span>
  </a>
  <button
    aria-controls="site-menu"
    aria-expanded="false"
    aria-label="打开导航"
    class="menu-toggle"
    type="button"
  >
    <SolarIcon class="menu-open-icon" name="hamburger-menu-linear" size={25} />
    <SolarIcon class="menu-close-icon" name="close-circle-linear" size={25} />
  </button>
</header>

<aside class="site-sidebar" id="site-menu">
  <a aria-label="ArcOfMarket 首页" class="site-brand" href="/">
    <span class="site-brand__arc">ARC</span>
    <span class="site-brand__of">OF</span>
    <span class="site-brand__market">MARKET</span>
    <SolarIcon class="site-brand__icon" name="round-graph-linear" size={38} />
  </a>

  <nav aria-label="主导航" class="primary-nav">
    {
      links.map((link) => (
        <a aria-current={link.match ? "page" : undefined} href={link.href}>
          <SolarIcon name={link.icon} size={22} />
          <span>{link.label}</span>
          <i />
        </a>
      ))
    }
  </nav>

  <div class="sidebar-section">
    <p>RESEARCH</p>
    <nav aria-label="研究导航" class="research-nav">
      {
        researchLinks.map((link) => (
          <a href={link.href}>
            <span>{link.label}</span>
            <i />
          </a>
        ))
      }
    </nav>
  </div>

  <div class="sidebar-meta">
    <p>每天收盘后更新</p>
    <p>研究与教育用途</p>
    <a href="/terms/">条款与数据政策</a>
  </div>
</aside>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const closeMenu = () => {
    document.body.classList.remove("menu-open");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "打开导航");
  };

  toggle?.addEventListener("click", () => {
    const open = document.body.classList.toggle("menu-open");
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "关闭导航" : "打开导航");
  });

  document.querySelectorAll("#site-menu a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>
