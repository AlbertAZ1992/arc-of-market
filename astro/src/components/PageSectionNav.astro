---
import SolarIcon from "@/components/SolarIcon.astro";

type NavItem = {
  href: string;
  label: string;
};

type Props = {
  current: string;
  items: readonly NavItem[];
};

const { current, items } = Astro.props;
---

<nav aria-label={`${current}本页目录`} class="page-section-nav" data-page-section-nav>
  <div class="page-section-nav__identity">
    <span>{current}</span>
    <strong>{items.length} 张图</strong>
  </div>
  <button aria-label="向前浏览图表目录" data-nav-direction="-1" type="button">
    <SolarIcon name="alt-arrow-left-linear" size={18} />
  </button>
  <div class="page-section-nav__track" data-nav-track>
    {
      items.map((item, index) => (
        <a data-nav-link href={item.href}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{item.label}</strong>
        </a>
      ))
    }
  </div>
  <button aria-label="向后浏览图表目录" data-nav-direction="1" type="button">
    <SolarIcon name="alt-arrow-right-linear" size={18} />
  </button>
</nav>

<script>
  document.querySelectorAll<HTMLElement>("[data-page-section-nav]").forEach((nav) => {
    const track = nav.querySelector<HTMLElement>("[data-nav-track]");
    const links = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
    );
    const buttons = Array.from(
      nav.querySelectorAll<HTMLButtonElement>("[data-nav-direction]"),
    );
    if (!track || links.length === 0) return;

    const setActive = (active: HTMLAnchorElement, reveal = true) => {
      links.forEach((link) => {
        if (link === active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
      if (reveal) {
        active.scrollIntoView({
          behavior: "smooth",
          block: "nearest",
          inline: "center",
        });
      }
    };

    const updateButtons = () => {
      const atStart = track.scrollLeft <= 2;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      buttons.forEach((button) => {
        button.disabled =
          button.dataset["navDirection"] === "-1" ? atStart : atEnd;
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const direction = Number(button.dataset["navDirection"] ?? 1);
        track.scrollBy({
          behavior: "smooth",
          left: direction * Math.min(track.clientWidth * 0.72, 620),
        });
      });
    });

    links.forEach((link) => {
      link.addEventListener("click", () => setActive(link));
    });

    const targets = links
      .map((link) => {
        const id = decodeURIComponent(link.hash.slice(1));
        const target = document.getElementById(id);
        return target ? { link, target } : null;
      })
      .filter((item): item is NonNullable<typeof item> => item !== null);

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top);
        const target = visible[0]?.target;
        const match = targets.find((item) => item.target === target);
        if (match) setActive(match.link);
      },
      { rootMargin: "-18% 0px -72% 0px" },
    );
    targets.forEach(({ target }) => observer.observe(target));

    const initial =
      links.find((link) => link.hash === window.location.hash) ?? links[0];
    if (initial) setActive(initial, false);
    track.addEventListener("scroll", updateButtons, { passive: true });
    window.addEventListener("resize", updateButtons);
    updateButtons();
  });
</script>

<style>
  .page-section-nav {
    background: var(--paper);
    border-bottom: 1px dotted var(--rule);
    display: grid;
    grid-template-columns: auto 2.8rem minmax(0, 1fr) 2.8rem;
    min-height: 3.2rem;
    position: sticky;
    top: var(--frame);
    z-index: 90;
  }

  .page-section-nav__identity {
    align-items: center;
    border-right: 1px dotted var(--rule);
    display: flex;
    gap: 0.7rem;
    min-width: 12.5rem;
    padding-inline: 1.1rem;
  }

  .page-section-nav__identity span {
    font-family: var(--font-serif);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .page-section-nav__identity strong {
    color: var(--main);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .page-section-nav > button {
    align-items: center;
    background: transparent;
    border: 0;
    border-right: 1px dotted var(--rule);
    cursor: pointer;
    display: flex;
    justify-content: center;
    padding: 0;
  }

  .page-section-nav > button:last-child {
    border-left: 1px dotted var(--rule);
    border-right: 0;
  }

  .page-section-nav > button:disabled {
    color: var(--ink-faint);
    cursor: default;
    opacity: 0.35;
  }

  .page-section-nav__track {
    display: flex;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
  }

  .page-section-nav__track::-webkit-scrollbar {
    display: none;
  }

  .page-section-nav__track a {
    align-items: center;
    border-right: 1px dotted var(--rule);
    display: flex;
    flex: 0 0 auto;
    gap: 0.4rem;
    min-height: 3.2rem;
    padding-inline: 0.9rem;
  }

  .page-section-nav__track a > span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.52rem;
  }

  .page-section-nav__track a > strong {
    font-size: 0.68rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .page-section-nav__track a[aria-current="location"] {
    background: var(--main);
    color: #fff;
  }

  .page-section-nav__track a[aria-current="location"] > span {
    color: #fff;
  }

  @media (max-width: 900px) {
    .page-section-nav {
      grid-template-columns: 2.55rem minmax(0, 1fr) 2.55rem;
      min-height: 2.8rem;
      top: 2.5rem;
    }

    .page-section-nav__identity {
      display: none;
    }

    .page-section-nav__track a {
      min-height: 2.8rem;
      padding-inline: 0.75rem;
    }
  }
</style>
