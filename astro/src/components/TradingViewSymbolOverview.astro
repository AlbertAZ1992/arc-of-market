---
type SymbolDefinition = readonly [label: string, symbol: string];

type Props = {
  label: string;
  symbols: readonly SymbolDefinition[];
};

const { label, symbols } = Astro.props;
const widgetConfig = JSON.stringify({
  lineWidth: 2,
  lineType: 0,
  chartType: "area",
  fontColor: "#5a5147",
  gridLineColor: "rgba(90, 81, 71, 0.12)",
  backgroundColor: "#fbf7ee",
  widgetFontColor: "#2b2620",
  upColor: "#4a7a4a",
  downColor: "#9a3b2e",
  colorTheme: "light",
  isTransparent: false,
  locale: "zh_CN",
  chartOnly: false,
  scalePosition: "right",
  scaleMode: "Normal",
  valuesTracking: "1",
  changeMode: "price-and-percent",
  symbols,
  dateRanges: ["1m|30", "3m|60", "12m|1D", "60m|1W", "all|1M"],
  fontSize: "11",
  headerFontSize: "medium",
  autosize: true,
  width: "100%",
  height: "100%",
  noTimeScale: false,
  hideDateRanges: false,
  hideMarketStatus: false,
  hideSymbolLogo: false,
});
---

<div class="chart-frame" aria-label={label}>
  <div class="tradingview-widget-container">
    <div class="tradingview-widget-container__widget"></div>
    <div class="tradingview-widget-copyright">
      <a href="https://www.tradingview.com/markets/" rel="noopener nofollow" target="_blank">
        Market data
      </a>
      by TradingView
    </div>
    <script
      is:inline
      type="text/javascript"
      src="https://s3.tradingview.com/external-embedding/embed-widget-symbol-overview.js"
      async
      set:html={widgetConfig}
    ></script>
  </div>
</div>

<style>
  .chart-frame {
    background: var(--paper-raised);
    border-block: 1px solid var(--rule);
    height: 34rem;
    padding-block: 1rem;
  }

  .tradingview-widget-container,
  .tradingview-widget-container__widget {
    height: 100%;
    width: 100%;
  }

  .tradingview-widget-copyright {
    font-size: 0.75rem;
    text-align: right;
  }

  @media (max-width: 640px) {
    .chart-frame {
      height: 28rem;
    }
  }
</style>
