---
import ArcJsonChart from "@/components/charts/ArcJsonChart.astro";
import FinancialStressChart from "@/components/charts/FinancialStressChart.astro";
import TradingViewHeatmap from "@/components/charts/TradingViewHeatmap.astro";
import SolarIcon from "@/components/SolarIcon.astro";

const acts = [
  ["01", "市场走到哪里了？", "#key-evidence"],
  ["02", "上涨是否健康？", "#story-health"],
  ["03", "风险是否被定价？", "#story-risk"],
  ["04", "市场处于什么周期？", "#story-cycle"],
  ["05", "历史给了什么参照？", "#story-history"],
] as const;
---

<section class="home-story" id="market-story">
  <header class="story-header">
    <div>
      <p class="eyebrow">FIVE-ACT MARKET STORY</p>
      <h2>从价格现象，走到风险、周期与历史参照。</h2>
    </div>
    <p>
      首页只保留能回答问题的关键图；完整历史、口径和更多拆解继续进入各专题页。
    </p>
  </header>

  <nav aria-label="五幕市场故事" class="story-index">
    {
      acts.map(([code, title, href]) => (
        <a href={href}>
          <span>{code}</span>
          <strong>{title}</strong>
        </a>
      ))
    }
  </nav>

  <article class="story-act" id="story-health">
    <header class="act-heading">
      <span>02</span>
      <div>
        <p class="eyebrow">MARKET PARTICIPATION</p>
        <h2>上涨是否健康？</h2>
        <p>先看当前涨跌是否扩散到更多行业与公司，还是主要由少数大权重推动。</p>
      </div>
      <aside>
        <strong>当前可确认</strong>
        <p>热力图用于观察当日横截面；可靠的历史市场广度序列尚未进入公开判断。</p>
      </aside>
    </header>
    <TradingViewHeatmap
      dataSource="SPX500"
      description="按市值和当日涨跌观察当前 S&P 500 横截面；点击公司查看明细。"
      id="home-market-heatmap"
      title="指数上涨由哪些公司推动？"
    />
    <a class="act-link" href="/sectors/">
      进入行业与七巨头结构
      <SolarIcon name="arrow-right-linear" size={18} />
    </a>
  </article>

  <article class="story-act" id="story-risk">
    <header class="act-heading">
      <span>03</span>
      <div>
        <p class="eyebrow">RISK PRICING</p>
        <h2>风险是否开始被市场定价？</h2>
        <p>波动、金融压力与信用利差需要相互确认，单一风险读数不能独立下结论。</p>
      </div>
      <aside>
        <strong>阅读顺序</strong>
        <p>先看 OFR 综合压力，再看企业信用利差是否同步扩大。</p>
      </aside>
    </header>
    <div class="story-charts">
      <FinancialStressChart />
      <ArcJsonChart
        dataPath="/data/macro_credit.json"
        description="高收益与投资级期权调整利差，用于观察企业信用风险定价。"
        eyebrow="RISK CONFIRMATION"
        id="home-credit-spreads"
        kind="nested"
        series={[
          { key: "hy_oas", label: "高收益 OAS", unit: "%" },
          { key: "ig_oas", label: "投资级 OAS", unit: "%" },
        ]}
        source="FRED · ICE Data Indices"
        title="信用利差是否确认风险扩散？"
      />
    </div>
    <a class="act-link" href="/macro/">
      进入完整宏观环境
      <SolarIcon name="arrow-right-linear" size={18} />
    </a>
  </article>

  <article class="story-act" id="story-cycle">
    <header class="act-heading">
      <span>04</span>
      <div>
        <p class="eyebrow">VALUATION & CYCLE</p>
        <h2>市场处于什么周期？</h2>
        <p>估值不能脱离资金价格和资产配置单独判断，趋势需要知道自己依赖什么条件。</p>
      </div>
      <aside>
        <strong>口径边界</strong>
        <p>配置比例与期限利差来自不同频率的数据，只判断所处位置，不伪装成实时信号。</p>
      </aside>
    </header>
    <div class="story-charts story-charts--two">
      <ArcJsonChart
        dataPath="/data/equity_allocation.json"
        description="观察美国金融资产中股票配置比例所处的历史位置。"
        eyebrow="CAPITAL ALLOCATION"
        id="home-equity-allocation"
        kind="valuation"
        source="Federal Reserve Z.1 · ArcOfMarket 计算"
        title="资金已经配置了多少股票？"
        valueKey="values"
        valueLabel="股票配置占比"
        yUnit="%"
      />
      <ArcJsonChart
        dataPath="/data/macro_rates.json"
        description="观察 10 年与 2 年美债利差的倒挂和再陡峭化，定位经济周期环境。"
        eyebrow="YIELD CURVE"
        id="home-yield-spread"
        kind="nested"
        series={[{ key: "t10y2y", label: "10Y − 2Y", unit: "%" }]}
        source="FRED"
        title="利率曲线处于什么位置？"
      />
    </div>
    <a class="act-link" href="/nasdaq/">
      进入纳斯达克长期研究
      <SolarIcon name="arrow-right-linear" size={18} />
    </a>
  </article>

  <article class="story-act" id="story-history">
    <header class="act-heading">
      <span>05</span>
      <div>
        <p class="eyebrow">HISTORICAL REFERENCE</p>
        <h2>历史给了什么参照？</h2>
        <p>历史用于列出可能路径与失败样本，不把相似形状包装成机械预测。</p>
      </div>
      <aside>
        <strong>带走的结论</strong>
        <p>看清当前状态是否常见，以及回撤与年度结果曾出现过哪些不同路径。</p>
      </aside>
    </header>
    <div class="story-charts story-charts--two">
      <ArcJsonChart
        dataPath="/data/sp500_drawdowns.json"
        description="从历史高点计算回撤，展示跌幅、持续时间和修复过程。"
        eyebrow="DRAWDOWN HISTORY"
        id="home-sp500-drawdowns"
        kind="drawdown"
        source="Yahoo Finance 历史价格 · ArcOfMarket 计算"
        title="历史回撤曾经有多深？"
      />
      <ArcJsonChart
        dataPath="/data/sp500_annual.json"
        description="按自然年聚合价格回报；未结束年份标记为年内数据。"
        eyebrow="ANNUAL OUTCOMES"
        id="home-sp500-annual"
        kind="annual"
        source="Yahoo Finance 历史价格 · ArcOfMarket 计算"
        title="年度结果通常落在哪里？"
      />
    </div>
    <a class="act-link" href="/sp500/">
      进入 S&P 500 市场编年史
      <SolarIcon name="arrow-right-linear" size={18} />
    </a>
  </article>
</section>

<style>
  .home-story {
    scroll-margin-top: 2rem;
  }

  .story-header {
    align-items: end;
    border-bottom: 1px solid var(--ink);
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
    padding: 4.5rem 0 2rem;
  }

  .story-header h2 {
    margin: 0.45rem 0 0;
  }

  .story-header > p {
    color: var(--ink-soft);
    font-size: 0.78rem;
    margin: 0;
  }

  .story-index {
    border-bottom: 1px dotted var(--rule);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .story-index a {
    display: grid;
    min-height: 5rem;
    padding: 0.85rem 1rem;
  }

  .story-index a:first-child {
    padding-left: 0;
  }

  .story-index a + a {
    border-left: 1px dotted var(--rule);
  }

  .story-index span {
    color: var(--main);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .story-index strong {
    align-self: end;
    font-family: var(--font-serif);
    font-size: 0.78rem;
  }

  .story-act {
    border-bottom: 1px solid var(--ink);
    padding: 4.5rem 0 2rem;
    scroll-margin-top: 2rem;
  }

  .act-heading {
    align-items: start;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 2.5rem minmax(0, 1.4fr) minmax(16rem, 0.55fr);
  }

  .act-heading > span {
    color: var(--main);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .act-heading h2 {
    margin: 0.3rem 0 0.65rem;
  }

  .act-heading > div > p:last-child,
  .act-heading aside p {
    color: var(--ink-soft);
    font-size: 0.78rem;
    margin: 0;
  }

  .act-heading aside {
    border-left: 1px solid var(--rule);
    padding-left: 1.3rem;
  }

  .act-heading aside strong {
    font-family: var(--font-serif);
    font-size: 0.8rem;
  }

  .story-charts--two {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .act-link {
    align-items: center;
    display: inline-flex;
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-weight: 700;
    gap: 0.35rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .story-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .story-charts--two {
      display: block;
    }
  }

  @media (max-width: 700px) {
    .story-header,
    .act-heading {
      display: block;
    }

    .story-header > p {
      margin-top: 1rem;
    }

    .act-heading > span {
      display: block;
      margin-bottom: 0.6rem;
    }

    .act-heading aside {
      border-left: 0;
      border-top: 1px solid var(--rule);
      margin-top: 1rem;
      padding: 1rem 0 0;
    }
  }
</style>
