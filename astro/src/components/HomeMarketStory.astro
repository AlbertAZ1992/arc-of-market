---
import ArcJsonChart from "@/components/charts/ArcJsonChart.astro";
import FinancialStressChart from "@/components/charts/FinancialStressChart.astro";
import SolarIcon from "@/components/SolarIcon.astro";

const acts = [
  ["01", "四类资产走势", "#key-evidence"],
  ["02", "标普与纳指广度", "#story-health"],
  ["03", "VIX 与金融压力", "#story-risk"],
  ["04", "配置比例与利率曲线", "#story-cycle"],
  ["05", "回撤与年度回报", "#story-history"],
] as const;
---

<section class="home-story" id="market-story">
  <header class="story-header">
    <div>
      <p class="eyebrow">FIVE MARKET CHECKS</p>
      <h2>首页按走势、广度、风险、资金配置和历史回撤组织数据。</h2>
    </div>
    <p>
      每部分保留一至两张图；完整历史区间、来源和更多拆解放在对应专题页。
    </p>
  </header>

  <nav aria-label="五组市场数据" class="story-index">
    {
      acts.map(([code, title, href]) => (
        <a href={href}>
          <span>{code}</span>
          <strong>{title}</strong>
        </a>
      ))
    }
  </nav>

  <article class="story-act" id="story-health">
    <header class="act-heading">
      <span>02</span>
      <div>
        <p class="eyebrow">MARKET PARTICIPATION</p>
        <h2>标普与纳指的 50 日、200 日市场广度</h2>
        <p>高于均线的成分比例用于区分多数股票参与和少数权重股拉动。</p>
      </div>
      <aside>
        <strong>读图提示</strong>
        <p>先比较两个指数的 50 日广度，再用 200 日广度确认中期趋势覆盖面。</p>
      </aside>
    </header>
    <div class="story-charts story-charts--two">
      <ArcJsonChart
        dataPath="/data/sp500_breadth.json"
        description="S&P 500 成分股中，高于 50 日与 200 日均线的比例。"
        eyebrow="S&P 500 BREADTH"
        id="home-sp500-breadth"
        interpretation={["50 日广度回答短期上涨是否扩散，200 日广度回答中期趋势是否普遍。"]}
        kind="multiline"
        series={[
          { key: "pct_above_50ma", label: ">50MA", unit: "%" },
          { key: "pct_above_200ma", label: ">200MA", unit: "%" },
        ]}
        source="Yahoo Finance · ArcOfMarket 计算"
        title="标普上涨有多少成分参与？"
        whatToWatch={["50 日广度跌破 50%，意味着多数成分短期趋势已经转弱。"]}
      />
      <ArcJsonChart
        dataPath="/data/ndx_breadth.json"
        description="Nasdaq-100 成分股中，高于 50 日与 200 日均线的比例。"
        eyebrow="NASDAQ-100 BREADTH"
        id="home-ndx-breadth"
        interpretation={["与标普广度对照，判断科技龙头上涨是否扩散到更多成分。"]}
        kind="multiline"
        series={[
          { key: "pct_above_50ma", label: ">50MA", unit: "%" },
          { key: "pct_above_200ma", label: ">200MA", unit: "%" },
        ]}
        source="Yahoo Finance · ArcOfMarket 计算"
        title="科技内部是否同步走强？"
        whatToWatch={["指数上涨但 50 日广度下降，说明上涨对少数权重股的依赖正在增加。"]}
      />
    </div>
    <a class="act-link" href="/sectors/">
      进入行业与七巨头结构
      <SolarIcon name="arrow-right-linear" size={18} />
    </a>
  </article>

  <article class="story-act" id="story-risk">
    <header class="act-heading">
      <span>03</span>
      <div>
        <p class="eyebrow">RISK PRICING</p>
        <h2>OFR 金融压力与 VIX 期限结构</h2>
        <p>OFR FSI 衡量金融系统压力；VIX 与 VIX3M 比较近端和三个月风险定价。</p>
      </div>
      <aside>
        <strong>阅读顺序</strong>
        <p>先看 OFR 综合压力，再看 VIX 期限结构是否转向近端风险。</p>
      </aside>
    </header>
    <div class="story-charts">
      <FinancialStressChart />
      <ArcJsonChart
        dataPath="/data/vol_family.json"
        description="比较 VIX 现货与三个月隐含波动率，观察市场在为眼前还是未来风险定价。"
        eyebrow="RISK CONFIRMATION"
        id="home-volatility-curve"
        kind="nested"
        series={[
          { key: "VIX", label: "VIX", unit: "指数", valueKey: "close" },
          { key: "VIX3M", label: "VIX3M", unit: "指数", valueKey: "close" },
        ]}
        source="Cboe Global Markets"
        title="VIX 与 VIX3M 的期限差"
      />
    </div>
    <a class="act-link" href="/macro/">
      进入完整宏观环境
      <SolarIcon name="arrow-right-linear" size={18} />
    </a>
  </article>

  <article class="story-act" id="story-cycle">
    <header class="act-heading">
      <span>04</span>
      <div>
        <p class="eyebrow">VALUATION & CYCLE</p>
        <h2>股票配置比例与美债 10 年减 2 年利差</h2>
        <p>股票配置比例显示资金已持有多少股票；期限利差显示长短端资金价格差。</p>
      </div>
      <aside>
        <strong>读图提示</strong>
        <p>配置比例与期限利差更新频率不同，重点比较各自的历史位置。</p>
      </aside>
    </header>
    <div class="story-charts story-charts--two">
      <ArcJsonChart
        dataPath="/data/equity_allocation.json"
        description="观察美国金融资产中股票配置比例所处的历史位置。"
        eyebrow="CAPITAL ALLOCATION"
        id="home-equity-allocation"
        kind="valuation"
        source="Federal Reserve Z.1 · ArcOfMarket 计算"
        title="资金已经配置了多少股票？"
        valueKey="values"
        valueLabel="股票配置占比"
        yUnit="%"
      />
      <ArcJsonChart
        dataPath="/data/macro_rates.json"
        description="观察 10 年与 2 年美债利差的倒挂和再陡峭化，定位经济周期环境。"
        eyebrow="YIELD CURVE"
        id="home-yield-spread"
        kind="nested"
        series={[{ key: "t10y2y", label: "10Y − 2Y", unit: "%" }]}
        source="FRED"
        title="利率曲线处于什么位置？"
      />
    </div>
    <a class="act-link" href="/nasdaq/">
      进入纳斯达克长期研究
      <SolarIcon name="arrow-right-linear" size={18} />
    </a>
  </article>

  <article class="story-act" id="story-history">
    <header class="act-heading">
      <span>05</span>
      <div>
        <p class="eyebrow">HISTORICAL REFERENCE</p>
        <h2>S&P 500 历史回撤与年度回报</h2>
        <p>回撤图记录从高点下跌及修复时间；年度图记录每个自然年的价格回报。</p>
      </div>
      <aside>
        <strong>数据用途</strong>
        <p>用历史分布确定当前幅度是否少见，不用相似图形预测下一次涨跌。</p>
      </aside>
    </header>
    <div class="story-charts story-charts--two">
      <ArcJsonChart
        dataPath="/data/sp500_drawdowns.json"
        description="从历史高点计算回撤，展示跌幅、持续时间和修复过程。"
        eyebrow="DRAWDOWN HISTORY"
        id="home-sp500-drawdowns"
        kind="drawdown"
        source="Yahoo Finance 历史价格 · ArcOfMarket 计算"
        title="历史回撤曾经有多深？"
      />
      <ArcJsonChart
        dataPath="/data/sp500_annual.json"
        description="按自然年聚合价格回报；未结束年份标记为年内数据。"
        eyebrow="ANNUAL OUTCOMES"
        id="home-sp500-annual"
        kind="annual"
        source="Yahoo Finance 历史价格 · ArcOfMarket 计算"
        title="年度结果通常落在哪里？"
      />
    </div>
    <a class="act-link" href="/sp500/">
      查看 S&P 500 历史数据
      <SolarIcon name="arrow-right-linear" size={18} />
    </a>
  </article>
</section>

<style>
  .home-story {
    scroll-margin-top: 2rem;
  }

  .story-header {
    align-items: end;
    border-bottom: 1px solid var(--ink);
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
    padding: 4.5rem 0 2rem;
  }

  .story-header h2 {
    margin: 0.45rem 0 0;
  }

  .story-header > p {
    color: var(--ink-soft);
    font-size: 0.78rem;
    margin: 0;
  }

  .story-index {
    border-bottom: 1px dotted var(--rule);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .story-index a {
    display: grid;
    min-height: 5rem;
    padding: 0.85rem 1rem;
  }

  .story-index a:first-child {
    padding-left: 0;
  }

  .story-index a + a {
    border-left: 1px dotted var(--rule);
  }

  .story-index span {
    color: var(--main);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .story-index strong {
    align-self: end;
    font-family: var(--font-serif);
    font-size: 0.78rem;
  }

  .story-act {
    border-bottom: 1px solid var(--ink);
    padding: 4.5rem 0 2rem;
    scroll-margin-top: 2rem;
  }

  .act-heading {
    align-items: start;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 2.5rem minmax(0, 1.4fr) minmax(16rem, 0.55fr);
  }

  .act-heading > span {
    color: var(--main);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .act-heading h2 {
    margin: 0.3rem 0 0.65rem;
  }

  .act-heading > div > p:last-child,
  .act-heading aside p {
    color: var(--ink-soft);
    font-size: 0.78rem;
    margin: 0;
  }

  .act-heading aside {
    border-left: 1px solid var(--rule);
    padding-left: 1.3rem;
  }

  .act-heading aside strong {
    font-family: var(--font-serif);
    font-size: 0.8rem;
  }

  .story-charts--two {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .act-link {
    align-items: center;
    display: inline-flex;
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-weight: 700;
    gap: 0.35rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .story-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .story-charts--two {
      display: block;
    }
  }

  @media (max-width: 700px) {
    .story-header,
    .act-heading {
      display: block;
    }

    .story-header > p {
      margin-top: 1rem;
    }

    .act-heading > span {
      display: block;
      margin-bottom: 0.6rem;
    }

    .act-heading aside {
      border-left: 0;
      border-top: 1px solid var(--rule);
      margin-top: 1rem;
      padding: 1rem 0 0;
    }
  }
</style>
