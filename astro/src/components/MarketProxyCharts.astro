---
import TradingViewSymbolOverview from "./TradingViewSymbolOverview.astro";
import { marketThemes } from "../lib/market-themes";

const marketProxies = [
  ["SPDR S&P 500 ETF", "AMEX:SPY|1D"],
  ["Invesco QQQ", "NASDAQ:QQQ|1D"],
  ["Vanguard S&P 500 ETF", "AMEX:VOO|1D"],
  ["Vanguard Value ETF", "AMEX:VTV|1D"],
] as const;

const sectorProxies = [
  ["科技 XLK", "AMEX:XLK|1D"],
  ["通信 XLC", "AMEX:XLC|1D"],
  ["可选消费 XLY", "AMEX:XLY|1D"],
  ["必需消费 XLP", "AMEX:XLP|1D"],
  ["能源 XLE", "AMEX:XLE|1D"],
  ["金融 XLF", "AMEX:XLF|1D"],
  ["医疗 XLV", "AMEX:XLV|1D"],
  ["工业 XLI", "AMEX:XLI|1D"],
  ["原材料 XLB", "AMEX:XLB|1D"],
  ["房地产 XLRE", "AMEX:XLRE|1D"],
  ["公用事业 XLU", "AMEX:XLU|1D"],
] as const;

const megaSeven = [
  ["Apple", "NASDAQ:AAPL|1D"],
  ["Microsoft", "NASDAQ:MSFT|1D"],
  ["Nvidia", "NASDAQ:NVDA|1D"],
  ["Amazon", "NASDAQ:AMZN|1D"],
  ["Alphabet", "NASDAQ:GOOGL|1D"],
  ["Meta", "NASDAQ:META|1D"],
  ["Tesla", "NASDAQ:TSLA|1D"],
] as const;
---

<section class="market-proxies" aria-labelledby="market-proxies-title">
  <header class="measure">
    <p class="faint">市场代理</p>
    <h2 id="market-proxies-title">大盘、成长与价值</h2>
    <p class="muted">
      用 SPY、VOO、QQQ 与 VTV 比较大盘、科技成长和价值风格。ETF 与对应指数的走势接近，
      但会受到费用、跟踪误差和交易时段影响。
    </p>
  </header>

  <TradingViewSymbolOverview label="SPY、VOO、QQQ 和 VTV 历史价格图" symbols={marketProxies} />

  <p class="chart-note faint measure">
    图表由 TradingView 组件提供；交易所与延迟状态以组件标示为准。
  </p>

  <div class="subsection measure">
    <p class="faint">行业代理</p>
    <h3>十一大板块</h3>
    <p class="muted">
      用 11 只 SPDR 行业 ETF 观察板块强弱；选择上方代码可以切换时间序列。
    </p>
  </div>

  <TradingViewSymbolOverview label="十一只行业 ETF 历史价格图" symbols={sectorProxies} />

  <div class="subsection measure">
    <p class="faint">集中度观察</p>
    <h3>Magnificent 7 成员分化</h3>
    <p class="muted">
      并列七家公司的价格路径，观察龙头之间何时同步、何时开始分化。
    </p>
  </div>

  <TradingViewSymbolOverview label="Magnificent 7 成员历史价格图" symbols={megaSeven} />

  <nav class="theme-map measure" aria-label="市场主题页">
    <p class="faint">独立主题页</p>
    <h3>从板块进入产业链</h3>
    <p class="muted">
      十一大 GICS 板块都有独立观察页；消费页同时拆开必需与可选消费。
      半导体和奢侈品作为跨行业专题保留，页面分别展示子行业代理与核心公司。
    </p>
    <div class="theme-links">
      {
        marketThemes.map((theme) => (
          <a href={`/themes/${theme.slug}`}>{theme.title}</a>
        ))
      }
    </div>
  </nav>
</section>

<style>
  .market-proxies {
    margin-block: var(--space-section);
  }

  .market-proxies header {
    margin-bottom: 2rem;
  }

  .market-proxies header h2 {
    margin-block: 0.25rem 0.75rem;
  }

  .chart-note {
    margin-top: 1rem;
  }

  .subsection {
    margin-block: 4rem 1.5rem;
  }

  .subsection h3 {
    margin-block: 0.25rem 0.75rem;
  }

  .theme-map {
    margin-top: 4rem;
  }

  .theme-map h3 {
    margin-block: 0.25rem 0.75rem;
  }

  .theme-links {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1.5rem;
  }

  .theme-links a {
    border-top: 1px solid var(--rule);
    padding-block: 0.75rem;
  }

  @media (max-width: 640px) {
    .theme-links {
      grid-template-columns: 1fr;
    }
  }
</style>
