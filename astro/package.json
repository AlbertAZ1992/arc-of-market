{
  "name": "arcofmarket",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "data:sync": "node scripts/sync-data.mjs",
    "dev": "pnpm data:sync && astro dev",
    "build": "pnpm data:sync && astro build && pnpm charts:audit",
    "charts:audit": "node scripts/audit-index-chart-coverage.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "oxlint --ignore-pattern \"**/*.astro\" src",
    "format": "oxfmt ."
  },
  "dependencies": {
    "astro": "^4.16.0",
    "echarts": "^5.5.0",
    "@iconify-json/solar": "^1.2.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@astrojs/check": "^0.9.0",
    "oxlint": "^0.9.0",
    "oxfmt": "^0.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
